---
/**
 * The hero's printed spreadsheet with a coffee ring and an unfinished total. Its rows are the
 * three receipts' labels and amounts (already formatted by the scene), and the last row is the
 * translated "TOTAL: ???". Text is real HTML; the column letters, the ring and the circle are
 * decoration. Logical properties only.
 */
import type { HTMLAttributes } from 'astro/types';
import Doodle from '../Doodle.astro';

interface Row {
  label: string;
  amount: string;
}

interface Props extends HTMLAttributes<'div'> {
  rows: Row[];
  total: string;
}

const { rows, total, class: className, ...rest } = Astro.props;
---

<div {...rest} class:list={['sheet', className]} data-prop="spreadsheet">
  <div class="sheet__cols" aria-hidden="true"><span></span><span>A</span><span>B</span></div>
  {
    rows.map((row, index) => (
      <p class="sheet__row">
        <span class="sheet__n" aria-hidden="true">{index + 1}</span>
        <span>{row.label}</span>
        <bdi>{row.amount}</bdi>
      </p>
    ))
  }
  <p class="sheet__row sheet__row--total">
    <span class="sheet__n" aria-hidden="true">{rows.length + 1}</span>
    <span class="sheet__total">
      {total}
      <Doodle kind="circle" tone="red" class="sheet__circle" />
    </span>
  </p>
  <span class="sheet__ring" aria-hidden="true"></span>
</div>

<style>
  .sheet {
    position: relative;
    background: var(--paper, #fffdf8);
    color: var(--ink, #1d2b24);
    box-shadow: var(--paper-shadow);
    border-radius: 3px;
    padding: 0.5rem 0.625rem 0.75rem;
    font-size: 0.8125rem;
    line-height: 1.3;
    min-inline-size: 0;
    overflow: hidden;
  }
  .sheet__cols,
  .sheet__row {
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr) auto;
    gap: 0.5rem;
    margin: 0;
    padding-block: 0.25rem;
    border-block-end: 1px solid #d9d2c1;
  }
  .sheet__cols {
    font-size: 0.6875rem;
    color: var(--ink-muted, #4e5a52);
    background: #efe9da;
    margin-inline: -0.625rem;
    padding-inline: 0.625rem;
  }
  .sheet__n {
    color: var(--ink-muted, #4e5a52);
    font-size: 0.6875rem;
  }
  .sheet__row--total {
    border-block-end: 0;
    grid-template-columns: 1.25rem minmax(0, 1fr);
  }
  .sheet__total {
    position: relative;
    justify-self: start;
    font-weight: 700;
    color: var(--thread-red-text, #b3362e);
    padding: 0.125rem 0.5rem;
  }
  .sheet__total :global(.sheet__circle) {
    position: absolute;
    inset: -0.25rem -0.125rem;
    inline-size: auto;
    block-size: auto;
    pointer-events: none;
  }
  .sheet__ring {
    position: absolute;
    inset-block-end: -1rem;
    inset-inline-end: 0.5rem;
    inline-size: 3.25rem;
    block-size: 3.25rem;
    border-radius: 50%;
    border: 0.3rem solid rgb(120 78 40 / 0.22);
    box-shadow: inset 0 0 0 0.1rem rgb(120 78 40 / 0.1);
    pointer-events: none;
  }
</style>
