---
/**
 * The footer (restructure 5.3, D22). Link groups come from the page registry; each group's
 * heading is an h2, styled small.
 */
import { logoFor } from '../nav/logo';
import { footerGroups } from '../nav/navigation';
import { t, tf, getLocalizedPath, type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const logo = logoFor(locale);
const groups = footerGroups(locale);
---

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <nav class="footer-grid" aria-label={t('a11y.footerNavigation', locale)}>
      <div class="footer-brand">
        <a href={getLocalizedPath('/', locale)} class="logo" aria-label={t('a11y.homeLink', locale)}>
          <img src={logo.src} alt={t('a11y.logoAlt', locale)} width={logo.width} height={logo.height} />
        </a>
        <p class="text-muted text-sm">{t('footer.tagline', locale)}</p>
      </div>

      {groups.map(group => (
        <div class="footer-links">
          <h2 id={`footer-${group.id}-heading`}>{group.heading}</h2>
          <ul aria-labelledby={`footer-${group.id}-heading`} role="list">
            {group.links.map(link => <li><a href={link.href}>{link.label}</a></li>)}
          </ul>
        </div>
      ))}
    </nav>

    <div class="footer-bottom flex items-center justify-between">
      <p class="text-muted text-sm">{tf('footer.copyright', { year: new Date().getFullYear() }, locale)}</p>
      <p class="text-muted text-sm">{t('footer.madeWith', locale)}</p>
    </div>
  </div>
</footer>
