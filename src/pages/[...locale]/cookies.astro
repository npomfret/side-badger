---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PolicyPage from '../../components/PolicyPage.astro';
import { t, type Locale } from '../../i18n';
import { canonicalFor } from '../../seo/urls';
import type { JsonLdNode } from '../../seo/jsonld';
import { pathsFor } from '../../site/routes';

export function getStaticPaths() {
  return pathsFor('cookies');
}

const { locale } = Astro.props as { locale: Locale };
const entry = await getEntry('policies', 'cookie-policy');

// English legal pages say when the text last changed (plan 2.5). Localized ones add nothing.
const jsonLd: JsonLdNode[] =
  locale === 'en' && entry
    ? [
        {
          '@type': 'WebPage',
          '@id': `${canonicalFor('cookies', locale)}#webpage`,
          dateModified: entry.data.publishedAt.toISOString(),
        },
      ]
    : [];
---

<BaseLayout
  page="cookies"
  locale={locale}
  title={t('policy.cookies.meta.title', locale)}
  description={t('policy.cookies.meta.description', locale)}
  jsonLd={jsonLd}
>
  <PolicyPage title={t('policy.cookies.title', locale)} policyId="cookie-policy" locale={locale} />
</BaseLayout>
