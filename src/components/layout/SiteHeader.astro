---
/**
 * The site header (restructure 5.1, 5.2, 5.10). Logo, four plain registry links (shown only for
 * published pages), the language switcher and the launch CTA; below the mobile breakpoint the
 * links move into the Popover API menu. `layout.css` sets `--header-h` to the header's bottom edge.
 */
import LanguageSwitcher from '../LanguageSwitcher.astro';
import LaunchAppCta from '../cta/LaunchAppCta.astro';
import MobileNav from './MobileNav.astro';
import { logoFor } from '../nav/logo';
import { navLinks } from '../nav/navigation';
import { t, getLocalizedPath, type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
  currentPath: string;
  /** The registry page the header is on (or `not-found`), for the launch counter and `aria-current` */
  pageId: string;
}

const { locale = 'en', currentPath, pageId } = Astro.props;
const links = navLinks(pageId, locale);
const logo = logoFor(locale);
---

<header class="site-header" role="banner">
  <div class="header-bar container">
    <a href={getLocalizedPath('/', locale)} class="logo" aria-label={t('a11y.homeLink', locale)}>
      <img src={logo.src} alt={t('a11y.logoAlt', locale)} width={logo.width} height={logo.height} />
    </a>

    {links.length > 0 && (
      <nav class="header-nav" aria-label={t('a11y.mainNavigation', locale)}>
        <ul class="nav-links" role="list">
          {links.map(link => (
            <li><a href={link.href} aria-current={link.current}>{link.label}</a></li>
          ))}
        </ul>
      </nav>
    )}

    <div class="header-actions">
      <LanguageSwitcher currentLocale={locale} currentPath={currentPath} />
      <LaunchAppCta target="app" cta="header" pageId={pageId} locale={locale} class="btn-launch" icon />
      <MobileNav links={links} locale={locale} pageId={pageId} />
    </div>
  </div>
</header>
