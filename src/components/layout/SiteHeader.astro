---
import LanguageSwitcher from '../LanguageSwitcher.astro';
import { t, logoLocales, getLocalizedPath, getAppUrl, type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
  currentPath: string;
}

const { locale = 'en', currentPath } = Astro.props;

const logoLocale = logoLocales.includes(locale) ? locale : 'en';
const smallLogoPath = `/images/${logoLocale}/logo-transparent-small.png`;
---

  <header class="site-header" role="banner">
    <nav class="header-nav container" aria-label={t('a11y.mainNavigation', locale)}>
      <a href={getLocalizedPath('/', locale)} class="logo" aria-label={t('a11y.homeLink', locale)}>
        <div class="logo-glow-wrapper">
          <div class="logo-glow-spacer"></div>
          <div class="logo-glow"></div>
          <img src={smallLogoPath} alt={t('header.logoText', locale) + ' logo'} height="100" />
        </div>
      </a>

      <ul class="nav-links flex items-center gap-lg" role="list">
        <li>
          <LanguageSwitcher currentLocale={locale} currentPath={currentPath} />
        </li>
        <li><a href={getAppUrl(locale)} class="btn btn-primary btn-launch">
          <span class="btn-launch-text">{t('header.launchApp', locale)}</span>
          <svg class="btn-launch-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 3 21 9"/>
            <line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
          <span class="sr-only">{t('a11y.externalLink', locale)}</span>
        </a></li>
      </ul>
    </nav>
  </header>
