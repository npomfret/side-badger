---
/**
 * A hub page (restructure 5.6, D23): the features index and the use-cases index. Hero with the
 * intro, cards for the hub's child pages (registry `parent`, each child's `h1` and
 * `meta.description`), further sections, an optional FAQ, and the closing call to action.
 *
 * JSON-LD (2.5): the WebPage becomes a `CollectionPage` about the app, plus an `ItemList` of the
 * cards. A hub is one level below Home, so BaseLayout shows and emits no breadcrumb (D22).
 */
import BaseLayout from './BaseLayout.astro';
import CardGrid from '../components/content/CardGrid.astro';
import ContentSection from '../components/content/ContentSection.astro';
import CtaBand from '../components/content/CtaBand.astro';
import ExtraSections from '../components/content/ExtraSections.astro';
import FaqList from '../components/content/FaqList.astro';
import PageHero from '../components/content/PageHero.astro';
import RelatedPages from '../components/content/RelatedPages.astro';
import { faqNode, itemListNode, webPageNode } from '../components/content/layout-jsonld';
import { childCards, relatedCards } from '../components/content/page-content';
import type { SitePageData } from '../content/schemas';
import type { Locale } from '../i18n';
import { requirePage, type PageId } from '../site/pages';

type HubData = Extract<SitePageData, { cardsHeading: string }>;

interface Props {
  data: HubData;
  pageId: string;
  locale: Locale;
}

const { data, pageId, locale } = Astro.props;
const page = requirePage(pageId);
const cards = await childCards(pageId, locale);
const others = await relatedCards(pageId, locale, other => other.parent !== pageId);
---

<BaseLayout
  page={pageId as PageId}
  title={data.meta.title}
  description={data.meta.description}
  locale={locale}
  ogCard={page.path.startsWith('/use-cases') ? 'use-cases' : 'features'}
  jsonLd={[
    webPageNode(pageId, locale, 'CollectionPage'),
    itemListNode(cards.map(card => ({ name: card.title, url: card.url }))),
    ...faqNode(data.faq),
  ]}
>
  <article class="content-page" data-page-type="hub" data-unpublished={page.published ? undefined : ''}>
    <PageHero h1={data.h1} lead={data.lead} intro={data.intro} pageId={pageId} locale={locale} />

    {cards.length > 0 && (
      <ContentSection heading={data.cardsHeading} id="cards">
        <CardGrid cards={cards} locale={locale} />
      </ContentSection>
    )}

    <ExtraSections sections={data.sections} locale={locale} />

    {data.faq && <FaqList faq={data.faq} locale={locale} />}

    <RelatedPages links={others} locale={locale} />

    <CtaBand cta={data.cta} pageId={pageId} locale={locale} />
  </article>
</BaseLayout>
