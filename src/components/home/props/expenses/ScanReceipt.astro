---
/** Receipt/camera/disclosure. Caller controls --scan-scanning-opacity and --scan-transition-ms. */
import Receipt from '../Receipt.astro';
import { t, type Locale } from '@/i18n';
import { receiptDate } from './helpers';
interface Props { locale: Locale; title: string; amount: string; }
const { locale, title, amount } = Astro.props;
---
<div class="scan-receipt">
  <div class="scan-receipt__paper">
    <Receipt title={title} lines={[{ label: t('home.expenses.fieldDate', locale), amount: receiptDate(locale) }]}
      total={{ label: t('home.expenses.fieldAmount', locale), amount }} />
    <svg class="scan-receipt__camera" data-testid="scan-camera" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <path d="M0 22V0H22M78 0H100V22M100 78V100H78M22 100H0V78" vector-effect="non-scaling-stroke"></path>
    </svg>
  </div>
  <small class="scan-receipt__note">{t('home.expenses.scanNote', locale)}</small>
</div>
<style>
  .scan-receipt { display: grid; gap: var(--space-sm); min-inline-size: 0; }
  .scan-receipt__paper { position: relative; padding: 0.5rem; }
  .scan-receipt__camera {
    position: absolute; inset: 0; inline-size: 100%; block-size: 100%;
    fill: none; stroke: var(--ink); stroke-width: 3; stroke-linecap: square;
    pointer-events: none; opacity: var(--scan-scanning-opacity, 0);
    transition: opacity var(--scan-transition-ms, 0s) linear;
  }
  .scan-receipt__note { color: var(--ink-muted); background: var(--surface); padding-inline: 0.5rem; }
  .scan-receipt :global(:is(.receipt__lines li, .receipt__total) > bdi) { flex: none; white-space: nowrap; }
</style>
