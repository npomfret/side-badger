---
/**
 * The currency choice both calculators open with (release 2, R3): the three the site's visitors use
 * most, then the other common ones, with the locale's likely currency added if it is not there
 * (`currencies.ts`). The calculator's script reads the allowed codes from the options. The one
 * currency applies to the whole calculation.
 */
import { localeConfig, t, type Locale } from '../../i18n';
import { currencyChoices, defaultCurrency, likelyCurrency } from './currencies';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { intlCode } = localeConfig[locale];

const chosen = defaultCurrency(locale, intlCode);
const currencies = currencyChoices(likelyCurrency(locale, intlCode));
const currencyNames = new Intl.DisplayNames(intlCode, { type: 'currency' });
const currencyName = (code: string) => {
  try {
    return currencyNames.of(code) ?? code;
  } catch {
    return code;
  }
};
---

<div class="sc-field sc-currency">
  <label for="sc-currency">{t('tools.split.currency', locale)}</label>
  <select id="sc-currency" data-ref="currency">
    {currencies.map(code => (
      <option value={code} selected={code === chosen}>{code} · {currencyName(code)}</option>
    ))}
  </select>
</div>
