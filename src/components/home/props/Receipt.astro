---
/**
 * A till receipt with a torn edge. Amounts arrive already formatted (`formatMoney()`), so this
 * wraps them in <bdi> and never builds a number itself. Dot leaders follow the text direction.
 * `size`: `regular` (default), `large` (a receipt held up to a camera) or `thumb` (an attachment
 * thumbnail; pair it with `decorative`, its text is too small to read).
 */
import type { HTMLAttributes } from 'astro/types';

interface Line {
  label: string;
  amount?: string;
}

interface Props extends HTMLAttributes<'div'> {
  title: string;
  lines?: Line[];
  total?: Line;
  rotate?: number;
  decorative?: boolean;
  size?: 'regular' | 'large' | 'thumb';
}

const { title, lines = [], total, rotate = 0, decorative = false, size = 'regular', class: className, style, ...rest } = Astro.props;
const tilt = rotate ? `--rot:${rotate}deg` : '';
---

<div
  {...rest}
  class:list={['receipt', size !== 'regular' && `receipt--${size}`, className]}
  data-prop="receipt"
  aria-hidden={decorative ? 'true' : undefined}
  style={[tilt, style].filter(Boolean).join(';') || undefined}
>
  <p class="receipt__title">{title}</p>
  {lines.length > 0 && (
    <ul class="receipt__lines">
      {lines.map(line => (
        <li><span>{line.label}</span>{line.amount && <bdi>{line.amount}</bdi>}</li>
      ))}
    </ul>
  )}
  {total && (
    <p class="receipt__total"><span>{total.label}</span>{total.amount && <bdi>{total.amount}</bdi>}</p>
  )}
  <slot />
</div>

<style>
  .receipt {
    background: var(--paper, #fffdf8);
    color: var(--ink, #1d2b24);
    box-shadow: var(--paper-shadow);
    padding: 0.75rem 0.875rem 1.25rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.8125rem;
    line-height: 1.35;
    rotate: var(--rot, 0deg);
    min-inline-size: 0;
    /* Torn bottom edge */
    mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% / 12px 100%;
  }
  .receipt--large {
    padding: 0.875rem 1rem 1.5rem;
    font-size: 1rem;
  }
  @media (max-width: 599px) {
    .receipt--large {
      padding-inline: 0.75rem;
      font-size: 0.875rem;
    }
  }
  /* Large type in a narrow camera view: the label wraps, never the amount */
  .receipt--large :is(.receipt__lines li, .receipt__total) > bdi {
    flex: none;
    white-space: nowrap;
  }
  .receipt--thumb {
    padding: 0.25rem 0.3125rem 0.5rem;
    font-size: 0.4375rem;
    line-height: 1.3;
    mask-size: 6px 100%;
    overflow: clip;
  }
  /* One line each: on the homepage `.home p` sets text-wrap, which would undo an inherited nowrap */
  .receipt--thumb :is(.receipt__title, .receipt__lines li, .receipt__total) {
    white-space: nowrap;
  }
  .receipt--thumb .receipt__title {
    margin-block-end: 0.25rem;
  }
  .receipt__title {
    margin: 0 0 0.5rem;
    font-weight: 700;
    text-align: center;
  }
  .receipt__lines {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .receipt__lines li,
  .receipt__total {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .receipt__total {
    margin: 0.5rem 0 0;
    padding-block-start: 0.375rem;
    border-block-start: 1px dashed var(--ink-muted, #4e5a52);
    font-weight: 700;
  }
</style>
