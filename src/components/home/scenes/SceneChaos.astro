---
/**
 * Scene 1 (`top`): the hero. The copy column (h1, one summary line, the actions) never animates.
 * The visual is one phone that scans the taxi receipt once in 4.5 seconds. Stages: 0 viewfinder
 * (the receipt inside camera marks), 1 scanning (a scan line sweeps down it), 2 fields land (the
 * receipt shrinks to a thumbnail; description, amount and date land in turn, ticked), 3 review
 * ("For you to check"). Desktop starts after paint; phones start when the visual enters. At rest
 * the replay button plays the pass again (timed engines only; the controller unhides it).
 * No-JS, static and reduced motion rest on the filled review form with no replay button. The form
 * reserves the visual's space in every stage; the camera view is laid over it.
 * Under copy and visual, the hero's footing: a card of what you get and a quieter line of what
 * you don't. Neither animates.
 */
import ScrollScene from '../ScrollScene.astro';
import AddExpenseForm from '../props/expenses/AddExpenseForm.astro';
import FactList from '../FactList.astro';
import IconButton from '@/components/controls/IconButton.astro';
import { t, type Locale } from '@/i18n';
import { formatMoney } from '../format';
import LaunchAppCta from '@/components/cta/LaunchAppCta.astro';
import { resolveHowItWorks } from '../data/links';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const howItWorks = resolveHowItWorks(locale);
const sample = { description: t('home.chaos.receiptTaxi', locale), amount: formatMoney(4200, 'JPY', locale) };
const facts = [
  { icon: 'scan-line', text: t('home.hero.fact.scanning', locale) },
  { icon: 'arrow-right-left', text: t('home.hero.fact.conversion', locale) },
  { icon: 'bot', text: t('home.hero.fact.assistants', locale) },
] as const;
const without = [
  t('home.hero.without.creepyTracking', locale),
  t('home.hero.without.sellingData', locale),
  t('home.hero.without.appDownload', locale),
  t('home.hero.without.formFilling', locale),
];
---

<ScrollScene id="top" titleId="top-title" runway="entry" play="once" duration={4500} stages={[15, 50, 80]} staticStage={3}>
  <Fragment slot="copy">
    <h1 id="top-title">{t('home.hero.title', locale)}</h1>
    <p>{t('home.hero.summary', locale)}</p>
    <div class="scene__link">
      <LaunchAppCta target="register" cta="hero" pageId="home" locale={locale} class="btn-lg">{t('home.hero.ctaPrimary', locale)}</LaunchAppCta>
      <a class="scene-link" href={howItWorks.href}>{t(howItWorks.labelKey, locale)}</a>
    </div>
  </Fragment>
  <div slot="visual" class="hero-scan" data-scene-entry data-testid="hero-scan">
    <AddExpenseForm locale={locale} scan={sample} />
    <IconButton class="hero-scan__replay" icon="rotate-ccw" label={t('home.hero.replay', locale)} tipAlign="end" data-scene-replay hidden />
  </div>
  <div class="hero-facts">
    <FactList tone="feature" label={t('home.hero.factsLabel', locale)} items={facts} />
    <FactList tone="without" label={t('home.hero.goodToKnowLabel', locale)} items={without} />
  </div>
</ScrollScene>
<style>
  /* The phone's width (AppFrame's sizing contract); the wrapper matches it, so the replay button
     sits on the phone's corner */
  .hero-scan {
    --frame-phone-width: 20rem;
    position: relative;
    inline-size: min(100%, var(--frame-phone-width));
    margin-inline: auto;
  }
  @media (max-width: 599px) {
    .hero-scan { --frame-phone-width: 18rem; }
  }
  /* Sits on the phone's lower inline-end corner, over the bezel: positioned, so it never moves layout */
  .hero-scan :global(.hero-scan__replay) {
    position: absolute;
    inset-block-end: -0.75rem;
    inset-inline-end: -1rem;
    z-index: 2;
  }
  .hero-facts {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--space-md);
    min-inline-size: 0;
  }
  /* The hero owns the stage-to-state mapping; shared props consume only semantic hooks. Until the
     controller has set a play state, a timed engine shows stage 0 so nothing flashes on load. */
  :global(html:is([data-scene-engine='native'], [data-scene-engine='stages']) .scene[data-scene='top']:not([data-play-state])) .hero-scan,
  :global(.scene[data-scene='top']:is([data-stage='0'], [data-stage='1'])) .hero-scan {
    --scan-viewfinder-opacity: 1;
    --scan-viewfinder-visibility: visible;
    --scan-viewfinder-scale: 1;
    --scan-fields-opacity: 0;
    --scan-fields-offset: -2rem;
  }
  :global(html:is([data-scene-engine='native'], [data-scene-engine='stages']) .scene[data-scene='top']:not([data-play-state])) .hero-scan,
  :global(.scene[data-scene='top'][data-stage='0']) .hero-scan {
    --scan-line-progress: 0;
  }
  :global(html:is([data-scene-engine='native'], [data-scene-engine='stages']) .scene[data-scene='top']:not([data-play-state])) .hero-scan,
  :global(.scene[data-scene='top']:is([data-stage='0'], [data-stage='1'], [data-stage='2'])) .hero-scan {
    --scan-review-opacity: 0;
    --scan-review-visibility: hidden;
  }
  :global(.scene[data-scene='top'][data-stage='1']) .hero-scan {
    --scan-scanning-opacity: 1;
    --scan-scanning-visibility: visible;
    --scan-line-opacity: 1;
  }
  /* Transitions only while a pass plays or rests: a replay's reset to pending is instant */
  :global(html:is([data-scene-engine='native'], [data-scene-engine='stages']) .scene[data-scene='top']:is([data-play-state='playing'], [data-play-state='done'])) .hero-scan {
    --scan-transition-ms: var(--duration-base);
    --scan-stagger-ms: var(--delay-land);
    --scan-sweep-ms: var(--duration-sweep);
  }
  /* Keep the existing hero copy geometry. */
  :global(#top .scene__stage) { padding-block-start: var(--space-lg); }
  #top-title:lang(ja), #top-title:lang(zh), #top-title:lang(ko) {
    font-size: clamp(1.625rem, 1.2vw + 1.25rem, 2.375rem);
    line-height: 1.25;
  }
  :global(.scene[data-scene='top'] .scene__copy:lang(ja)),
  :global(.scene[data-scene='top'] .scene__copy:lang(zh)),
  :global(.scene[data-scene='top'] .scene__copy:lang(ko)) {
    gap: 0.625rem;
    font-size: 1rem;
    line-height: 1.55;
  }
</style>
