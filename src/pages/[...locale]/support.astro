---
// The help page (release 2, R9). The content entry is `pages/support/<locale>.yaml`.
import SupportPageLayout from '../../layouts/SupportPageLayout.astro';
import { layoutPaths, loadPageContent } from '../../components/content/page-content';
import type { SupportPageData } from '../../content/schemas';
import type { Locale } from '../../i18n';

export async function getStaticPaths() {
  return layoutPaths('support', id => id === 'support');
}

const { pageId, locale } = Astro.props as { pageId: string; locale: Locale };
// Never falls back to English: a missing entry throws
const data = await loadPageContent<SupportPageData>(pageId, locale);
---

<SupportPageLayout data={data} pageId={pageId} locale={locale} />
