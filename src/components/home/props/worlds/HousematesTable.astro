---
/**
 * The housemates table: a shopping list that ticks "4 of 7" and a sticky note. The boxes are
 * decoration; the list's words (with the count) are the paper's label, so they stay content.
 * `data-mech="tick"` marks the ticks the scene animates on the native engine.
 */
interface Props {
  one: string;
  two: string;
}
const { one, two } = Astro.props;
const boxes = Array.from({ length: 7 }, (_, i) => i);
---

<div class="mech">
  <div class="list" data-prop="paper">
    <p class="label">{one}</p>
    <ul class="boxes" aria-hidden="true">
      {
        boxes.map(i => (
          <li class="box">
            {i < 4 && (
              <svg class="tick" data-mech="tick" style={`--i:${i}`} viewBox="0 0 16 16" focusable="false">
                <path d="M3 8.5 6.3 11.7 13 4.8" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
          </li>
        ))
      }
    </ul>
  </div>
  <div class="note" data-prop="sticky"><i class="magnet" aria-hidden="true"></i>{two}</div>
</div>

<style>
  .mech {
    display: grid;
    gap: 1rem;
    min-inline-size: 0;
  }
  .list {
    background: var(--paper);
    color: var(--ink);
    border-radius: 3px;
    box-shadow: var(--paper-shadow);
    padding: 0.875rem 1rem;
    display: grid;
    gap: 0.625rem;
    rotate: -1deg;
  }
  .label,
  .note {
    margin: 0;
    color: var(--ink);
    font-weight: 600;
    line-height: 1.3;
  }
  .boxes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .box {
    inline-size: 1.75rem;
    block-size: 1.75rem;
    border: 2px solid var(--ink);
    border-radius: 4px;
    display: grid;
    place-items: center;
  }
  .tick {
    inline-size: 1.1rem;
    block-size: 1.1rem;
    color: var(--green-ink);
  }
  .note {
    position: relative;
    background: var(--sticky-yellow);
    box-shadow: var(--paper-shadow);
    padding: 1rem 1rem 1.125rem;
    rotate: 1.5deg;
    max-inline-size: 22rem;
    justify-self: end;
    border-end-end-radius: 14px 4px;
  }
  .magnet {
    position: absolute;
    inset-block-start: -0.5rem;
    inset-inline-start: 50%;
    translate: calc(-50% * var(--dir, 1)) 0;
    inline-size: 1rem;
    block-size: 1rem;
    border-radius: 50%;
    background: var(--magnet, #d6553f);
    box-shadow: var(--paper-shadow);
  }
</style>
