---
/**
 * A product screenshot from `src/assets/screenshots/<id>/<locale|neutral>.png` (D26, D33).
 * - `missing` shots and `placeholder-en` shots on non-English pages render nothing.
 * - A localized shot whose locale file is missing fails the build; there is no English fallback.
 * Alt text comes from page content and describes what the image proves.
 * `eager` is for the first shot on a page; every other shot lazy-loads.
 * Output is AVIF with a WebP `<img>` fallback (site plan, "Formats and sizes"), so no PNG copies.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getShot } from '@/data/screenshots';
import type { Locale } from '@/i18n';

interface Props {
  id: string;
  locale: Locale;
  alt: string;
  eager?: boolean;
  class?: string;
}

const { id, locale, alt, eager = false, class: className } = Astro.props;
const shot = getShot(id);

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/screenshots/*/*.png');

const wanted = shot.localized ? locale : 'neutral';
const show =
  shot.status === 'captured' || (shot.status === 'placeholder-en' && locale === 'en');
// A placeholder-en shot is an English file, wherever its page shows it
const fileName = shot.status === 'placeholder-en' ? 'en' : wanted;
const load = show ? files[`/src/assets/screenshots/${shot.id}/${fileName}.png`] : undefined;
if (show && !load) {
  throw new Error(
    `Screenshot ${shot.id} (${shot.status}) has no file src/assets/screenshots/${shot.id}/${fileName}.png for page locale "${locale}"`
  );
}
const image = load ? (await load()).default : undefined;
const widths = shot.viewport === 'mobile' ? [390, 780] : [480, 960, 1440];
const sizes = `(min-width: ${shot.width}px) ${shot.width}px, 100vw`;
---

{
  image && (
    <Picture
      src={image}
      alt={alt}
      formats={['avif']}
      fallbackFormat="webp"
      widths={widths}
      sizes={sizes}
      width={shot.width}
      height={shot.height}
      loading={eager ? 'eager' : 'lazy'}
      decoding={eager ? 'auto' : 'async'}
      class={className}
    />
  )
}
