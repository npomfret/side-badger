---
/**
 * The closing call to action of a content page (every brief ends with one): the entry's `cta`
 * heading and body, and a register link through the launch counter with the site's one main
 * button label, `home.hero.ctaPrimary`.
 */
import LaunchAppCta from '../cta/LaunchAppCta.astro';
import { t, type Locale } from '../../i18n';
import RichText from './RichText.astro';

interface Props {
  cta: { heading: string; body: string };
  pageId: string;
  locale: Locale;
}

const { cta, pageId, locale } = Astro.props;
---

<section class="cta-band" aria-labelledby="cta-heading" data-section="cta">
  <div class="container">
    <div class="cta-band__card glass">
      <h2 id="cta-heading">{cta.heading}</h2>
      <RichText as="p" text={cta.body} locale={locale} />
      <LaunchAppCta target="register" cta="footer-cta" pageId={pageId} locale={locale} confetti>
        {t('home.hero.ctaPrimary', locale)}
      </LaunchAppCta>
    </div>
  </div>
</section>

<style>
  .cta-band {
    padding-block: var(--space-2xl) var(--space-3xl);
  }

  .cta-band__card {
    padding: var(--space-2xl) var(--space-xl);
    text-align: center;
  }

  .cta-band h2 {
    margin: 0 0 var(--space-md);
    font-size: var(--text-3xl);
    line-height: var(--heading-line-height);
    overflow-wrap: anywhere;
  }

  .cta-band :global(p) {
    margin: 0 auto var(--space-lg);
    max-inline-size: 55ch;
  }
</style>
