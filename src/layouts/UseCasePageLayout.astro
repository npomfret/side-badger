---
/**
 * A use-case page (restructure 5.6, D23): hero, scenario, worked example (required), further
 * sections from the brief, the features used (links to the feature pages), an optional FAQ, the
 * published guides that name the page, and the closing call to action. See FeaturePageLayout for
 * how `data` and the JSON-LD work.
 */
import BaseLayout from './BaseLayout.astro';
import CardGrid from '../components/content/CardGrid.astro';
import ContentSection from '../components/content/ContentSection.astro';
import CtaBand from '../components/content/CtaBand.astro';
import ExtraSections from '../components/content/ExtraSections.astro';
import FaqList from '../components/content/FaqList.astro';
import PageHero from '../components/content/PageHero.astro';
import RelatedPages from '../components/content/RelatedPages.astro';
import RichText from '../components/content/RichText.astro';
import WorkedExample from '../components/content/WorkedExample.astro';
import { faqNode, webPageNode } from '../components/content/layout-jsonld';
import { relatedCards } from '../components/content/page-content';
import type { UseCasePageData } from '../content/schemas';
import { t, type Locale } from '../i18n';
import { requirePage, type PageId } from '../site/pages';

interface Props {
  data: UseCasePageData;
  pageId: string;
  locale: Locale;
}

const { data, pageId, locale } = Astro.props;
const page = requirePage(pageId);
const features = await relatedCards(pageId, locale, other => other.type === 'feature');
const others = await relatedCards(pageId, locale, other => other.type !== 'feature' && other.type !== 'article');
const guides = await relatedCards(pageId, locale, other => other.type === 'article');
---

<BaseLayout
  page={pageId as PageId}
  title={data.meta.title}
  description={data.meta.description}
  locale={locale}
  ogCard="use-cases"
  breadcrumbName={data.h1}
  jsonLd={[webPageNode(pageId, locale), ...faqNode(data.faq)]}
>
  <article class="content-page" data-page-type="use-case" data-unpublished={page.published ? undefined : ''}>
    <PageHero h1={data.h1} lead={data.lead} pageId={pageId} locale={locale} example={data.example} />

    <ContentSection heading={data.scenario.heading} id="scenario">
      <RichText as="p" text={data.scenario.body} locale={locale} />
    </ContentSection>

    <ExtraSections sections={data.sections} locale={locale} to={data.exampleAfter ?? 0} />

    <WorkedExample example={data.example} locale={locale} />

    <ExtraSections sections={data.sections} locale={locale} from={data.exampleAfter ?? 0} />

    {features.length > 0 && (
      <ContentSection heading={data.featuresHeading} id="features">
        <CardGrid cards={features} locale={locale} />
      </ContentSection>
    )}

    {data.faq && <FaqList faq={data.faq} locale={locale} />}

    <RelatedPages links={guides} locale={locale} heading={t('related.guidesHeading', locale)} id="guides" />

    <RelatedPages links={others} locale={locale} />

    <CtaBand cta={data.cta} pageId={pageId} locale={locale} />
  </article>
</BaseLayout>
