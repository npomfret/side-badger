---
/**
 * A group-chat bubble. `side` is logical: `start` sits at the inline-start edge and `end` at the
 * inline-end edge, so the pair mirrors in right-to-left locales. Its text is content, like the
 * other text props; set `decorative` only when the words repeat text already on the page.
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  side?: 'start' | 'end';
  decorative?: boolean;
}

const { side = 'start', decorative = false, class: className, ...rest } = Astro.props;
---

<div
  {...rest}
  class:list={['bubble', `bubble--${side}`, className]}
  data-prop="bubble"
  aria-hidden={decorative ? 'true' : undefined}
>
  <slot />
</div>

<style>
  .bubble {
    max-inline-size: 85%;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    line-height: 1.3;
    border-radius: 14px;
    min-inline-size: 0;
  }
  .bubble--start {
    justify-self: start;
    background: #fff;
    color: var(--app-ink, #1f2937);
    border-end-start-radius: 4px;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.15);
  }
  .bubble--end {
    justify-self: end;
    background: var(--app-primary-dark, #15803d);
    color: #fff;
    border-end-end-radius: 4px;
  }
</style>
