---
// A use-case page (restructure 6.1). The content entry is `use-cases/<slug>/<locale>.yaml`.
import UseCasePageLayout from '../../../layouts/UseCasePageLayout.astro';
import { layoutPaths, loadPageContent } from '../../../components/content/page-content';
import type { UseCasePageData } from '../../../content/schemas';
import type { Locale } from '../../../i18n';

export async function getStaticPaths() {
  return layoutPaths('use-case');
}

const { pageId, locale } = Astro.props as { pageId: string; locale: Locale };
const data = await loadPageContent<UseCasePageData>(pageId, locale);
---

<UseCasePageLayout data={data} pageId={pageId} locale={locale} />
