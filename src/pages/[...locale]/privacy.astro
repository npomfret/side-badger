---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PolicyPage from '../../components/PolicyPage.astro';
import { t, type Locale } from '../../i18n';
import { pathsFor } from '../../site/routes';

export function getStaticPaths() {
  return pathsFor('privacy');
}

const { locale } = Astro.props as { locale: Locale };
---

<BaseLayout
  page="privacy"
  locale={locale}
  title={t('policy.privacy.meta.title', locale)}
  description={t('policy.privacy.meta.description', locale)}
>
  <PolicyPage title={t('policy.privacy.title', locale)} policyId="privacy-policy" locale={locale} />
</BaseLayout>
