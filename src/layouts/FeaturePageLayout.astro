---
/**
 * A feature page (restructure 5.6, D23): hero (h1, lead, call to action, first shot), problem,
 * workflow steps, options, the worked example and further sections when the brief has them,
 * limits, related use cases, FAQ, final call to action.
 *
 * `data` is the page's content entry for the locale (`loadPageContent`), already validated by
 * `featurePage`; the route file loads it and never falls back to English. Numbers in the worked
 * example are computed at build time. JSON-LD: WebPage (about the app), FAQPage for the visible
 * FAQ, and the BreadcrumbList BaseLayout builds from the registry (`breadcrumbName`).
 */
import BaseLayout from './BaseLayout.astro';
import CardGrid from '../components/content/CardGrid.astro';
import ContentSection from '../components/content/ContentSection.astro';
import CtaBand from '../components/content/CtaBand.astro';
import ExtraSections from '../components/content/ExtraSections.astro';
import FaqList from '../components/content/FaqList.astro';
import LimitsList from '../components/content/LimitsList.astro';
import PageHero from '../components/content/PageHero.astro';
import RelatedPages from '../components/content/RelatedPages.astro';
import RichText from '../components/content/RichText.astro';
import WorkedExample from '../components/content/WorkedExample.astro';
import WorkflowSteps from '../components/content/WorkflowSteps.astro';
import { isBetaPage } from '../components/content/beta';
import { faqNode, webPageNode } from '../components/content/layout-jsonld';
import { relatedCards } from '../components/content/page-content';
import type { FeaturePageData } from '../content/schemas';
import type { Locale } from '../i18n';
import { requirePage, type PageId } from '../site/pages';

interface Props {
  data: FeaturePageData;
  pageId: string;
  locale: Locale;
}

const { data, pageId, locale } = Astro.props;
const page = requirePage(pageId);
const heroShot = data.workflow.steps.find(step => step.shot);
const useCases = await relatedCards(pageId, locale, other => other.type === 'use-case');
const others = await relatedCards(pageId, locale, other => other.type !== 'use-case');
---

<BaseLayout
  page={pageId as PageId}
  title={data.meta.title}
  description={data.meta.description}
  locale={locale}
  ogCard="features"
  breadcrumbName={data.h1}
  jsonLd={[webPageNode(pageId, locale), ...faqNode(data.faq)]}
>
  <article class="content-page" data-page-type="feature" data-unpublished={page.published ? undefined : ''}>
    <PageHero
      h1={data.h1}
      lead={data.lead}
      pageId={pageId}
      locale={locale}
      beta={isBetaPage(pageId)}
      example={data.example}
      shot={heroShot?.shot ? { id: heroShot.shot, alt: heroShot.shotAlt ?? '' } : undefined}
    />

    <ContentSection heading={data.problem.heading} id="problem">
      <RichText as="p" text={data.problem.body} locale={locale} />
    </ContentSection>

    <ContentSection heading={data.workflow.heading} id="workflow">
      <WorkflowSteps steps={data.workflow.steps} locale={locale} skipShot={heroShot?.shot} />
    </ContentSection>

    {data.options.items.length > 0 && (
      <ContentSection heading={data.options.heading} id="options">
        <ul class="options-grid" role="list">
          {data.options.items.map(item => (
            <li class="option glass">
              <h3>{item.title}</h3>
              <RichText as="p" text={item.body} locale={locale} />
            </li>
          ))}
        </ul>
      </ContentSection>
    )}

    {data.example && data.exampleAfter === undefined && <WorkedExample example={data.example} locale={locale} />}

    {data.example && data.exampleAfter !== undefined ? (
      <>
        <ExtraSections sections={data.sections} locale={locale} to={data.exampleAfter} />
        <WorkedExample example={data.example} locale={locale} />
        <ExtraSections sections={data.sections} locale={locale} from={data.exampleAfter} />
      </>
    ) : (
      <ExtraSections sections={data.sections} locale={locale} />
    )}

    <LimitsList limits={data.limits} locale={locale} />

    {useCases.length > 0 && (
      <ContentSection heading={data.useCasesHeading} id="use-cases">
        <CardGrid cards={useCases} locale={locale} />
      </ContentSection>
    )}

    <FaqList faq={data.faq} locale={locale} />

    <RelatedPages links={others} locale={locale} />

    <CtaBand cta={data.cta} pageId={pageId} locale={locale} />
  </article>
</BaseLayout>

<style>
  .options-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
    gap: var(--space-lg);
  }

  .option {
    padding: var(--space-lg);
  }

  .option h3 {
    margin: 0 0 var(--space-sm);
    font-size: var(--text-xl);
    overflow-wrap: anywhere;
  }

  .option :global(p) {
    margin: 0;
  }
</style>
