---
/**
 * One expense card in scene 3's ledger: title, split type, the amount as it was paid, and an
 * optional aside. It drops in at stage 3 (`rise` from above); `from`/`to` are its native range.
 */
import { t, type Locale, type TranslationKey } from '@/i18n';
import Avatar from '../Avatar.astro';
import type { Expense } from '../../data/example-group';
import { formatMoney } from '../../format';
import { expenseTitle, memberColor, memberName, SPLIT_KEYS } from './helpers';

interface Props {
  expense: Expense;
  locale: Locale;
  from: number;
  to: number;
  index: number;
}
const { expense, locale, from, to, index } = Astro.props;
const payer = memberName(expense.paidBy, locale);
---

<li class="lc" data-anim="rise" data-at="3" style={`--dy:-32px;--from:${from};--to:${to};--i:${index}`}>
  <Avatar name={payer} color={memberColor(expense.paidBy)} size="2rem" />
  <div class="lc__body">
    <p class="lc__head">
      <strong>{expenseTitle(expense, locale)}</strong>
      <span class="lc__sep" aria-hidden="true">·</span>
      <span class="lc__split">{t(SPLIT_KEYS[expense.split.kind], locale)}</span>
    </p>
    {expense.noteKey && <p class="lc__note">{t(expense.noteKey as TranslationKey, locale)}</p>}
  </div>
  <bdi class="lc__amount">{formatMoney(expense.original.minor, expense.original.currency, locale)}</bdi>
</li>

<style>
  .lc {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.625rem;
    padding: 0.375rem 0.75rem;
    background: var(--paper, #fffdf8);
    border-radius: 6px;
    box-shadow: var(--paper-shadow);
    color: var(--ink, #1d2b24);
    list-style: none;
  }
  .lc__body {
    min-inline-size: 0;
  }
  .lc__head {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.375rem;
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.3;
  }
  .lc__split {
    color: var(--ink-muted, #4e5a52);
  }
  .lc__note {
    margin: 0.125rem 0 0;
    font-size: 0.8125rem;
    font-style: italic;
    color: var(--ink-muted, #4e5a52);
  }
  .lc__amount {
    font-weight: 700;
    font-size: 0.9375rem;
    white-space: nowrap;
  }
</style>
