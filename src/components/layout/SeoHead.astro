---
/**
 * The whole SEO head (restructure 2.5, D6): title, description, robots, canonical, hreflang,
 * Open Graph, Twitter and one JSON-LD @graph, in that order. Everything comes from the page id
 * and locale: indexability from `isIndexable`, tags from `localeConfig`, URLs from `src/seo/urls`.
 */
import { readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { resolve } from 'node:path';
import { OG_RENDER_VERSION, type OgCardId } from '../../pages/og/[card].png';
import { t, logoLocales, localeConfig, type Locale } from '../../i18n';
import type { PageId } from '../../site/pages';
import { absoluteUrl, canonicalFor } from '../../seo/urls';
import { isIndexable } from '../../seo/indexability';
import { alternatesFor } from '../../seo/alternates';
import { buildGraph, serializeJsonLd, type JsonLdNode } from '../../seo/jsonld';

interface Props {
  page: PageId | 'not-found';
  locale: Locale;
  title: string;
  description: string;
  ogCard?: OgCardId;
  jsonLd?: JsonLdNode[];
}

const { page, locale, title, description, ogCard = 'default', jsonLd = [] } = Astro.props;

const indexable = isIndexable(page, locale);
const canonical = page === 'not-found' ? undefined : canonicalFor(page, locale);
const alternates = alternatesFor(page, locale);

// Social card: language-neutral artwork with the locale's wordmark. The version is the first
// 8 hex characters of a hash of both inputs plus the route's render version, so a change to any
// is fetched under a new URL (D27).
const logoLocale = logoLocales.includes(locale) ? locale : 'en';
const cardHash = createHash('sha256')
  .update(readFileSync(resolve('src/assets/og', `${ogCard}.png`)))
  .update(readFileSync(resolve('public/images', logoLocale, 'logo-transparent.png')))
  .update(OG_RENDER_VERSION)
  .digest('hex')
  .slice(0, 8);
const ogImage = absoluteUrl(`/og/${ogCard}-${logoLocale}.png?v=${cardHash}`);
const ogImageAlt = t('header.logoText', locale);

const graph = buildGraph({
  pageId: page,
  locale,
  name: title,
  description,
  nodes: jsonLd,
  // One Organization (one @id) site-wide, so one logo: the English wordmark
  logoUrl: absoluteUrl('/images/en/logo-transparent.png'),
});
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
{!indexable && <meta name="robots" content="noindex" />}
{indexable && canonical && (
  <>
    <link rel="canonical" href={canonical} />
    <meta property="og:url" content={canonical} />
  </>
)}
{alternates.map((alternate) => (
  <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
))}

<!-- Open Graph -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Side Badger" />
<meta property="og:locale" content={localeConfig[locale].ogLocale} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />

<meta name="theme-color" content="#F0FDF4" />
<link rel="apple-touch-icon" href="/images/icons/apple-touch-icon.png" />
<link rel="icon" type="image/png" sizes="192x192" href="/images/icons/icon-192.png" />

{graph.length > 0 && <script type="application/ld+json" set:html={serializeJsonLd(graph)} />}

<slot name="head" />
