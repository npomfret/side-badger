---
// Client-side language detection for a static site (D5).
// On a first visit to an English page it picks the first browser language that maps to a
// locale built for this deployment, and moves to that locale's version of the same page.
// It never redirects to an alias URL, a pseudo-locale or a locale that was not built.
import { getBuildLocales, isPseudoLocale, localeConfig, localeForBrowserLanguage, locales, type Locale } from '../i18n';

interface Props {
  currentLocale: Locale;
}

const { currentLocale } = Astro.props;

const built = new Set<string>(getBuildLocales().filter(locale => !isPseudoLocale(locale)));

// Every browser language tag any locale claims, resolved by the shared rule and kept only
// when the target was built.
const tagTable: Record<string, string> = {};
for (const locale of locales) {
  for (const tag of localeConfig[locale].browserLanguages) {
    const target = localeForBrowserLanguage(tag);
    if (target && built.has(target)) tagTable[tag] = target;
  }
}

// hreflang value of each built locale, to find its alternate link on the page
const hreflangs: Record<string, string> = {};
for (const locale of built) hreflangs[locale] = localeConfig[locale as keyof typeof localeConfig].hreflang;
---

<script is:inline define:vars={{ currentLocale, tagTable, hreflangs }}>
  (function () {
    var LOCALE_KEY = 'preferred-locale';

    // Detection only moves visitors off an English page. A localized page is where they chose to be.
    if (currentLocale !== 'en') return;

    try {
      // Skip when a preference is already stored (the switcher stores one on every choice)
      if (localStorage.getItem(LOCALE_KEY)) return;
    } catch (e) {
      return;
    }

    var tags = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language];
    var preferred = 'en';
    for (var i = 0; i < tags.length; i++) {
      var tag = String(tags[i] || '').toLowerCase();
      var match = tagTable[tag] || tagTable[tag.split('-')[0]];
      if (match) {
        preferred = match;
        break;
      }
    }

    try {
      localStorage.setItem(LOCALE_KEY, preferred);
    } catch (e) {
      // Without storage the choice could not stick, so do not redirect on every visit
      return;
    }

    if (preferred === 'en') return;

    // Go only where the page itself declares a version in that locale
    var links = document.querySelectorAll('link[rel="alternate"][hreflang]');
    var wanted = [String(hreflangs[preferred]).toLowerCase(), preferred.toLowerCase()];
    for (var j = 0; j < links.length; j++) {
      var lang = (links[j].getAttribute('hreflang') || '').toLowerCase();
      if (wanted.indexOf(lang) === -1) continue;
      var url;
      try {
        url = new URL(links[j].href, location.href);
      } catch (e) {
        continue;
      }
      // Alternates carry the production origin; keep the visitor on the current host
      if (url.pathname === location.pathname) return;
      location.replace(url.pathname + location.search + location.hash);
      return;
    }
  })();
</script>
