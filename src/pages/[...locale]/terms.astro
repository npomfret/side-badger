---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PolicyPage from '../../components/PolicyPage.astro';
import { t, type Locale } from '../../i18n';
import { pathsFor } from '../../site/routes';

export function getStaticPaths() {
  return pathsFor('terms');
}

const { locale } = Astro.props as { locale: Locale };
---

<BaseLayout
  page="terms"
  locale={locale}
  title={t('policy.terms.meta.title', locale)}
  description={t('policy.terms.meta.description', locale)}
>
  <PolicyPage title={t('policy.terms.title', locale)} policyId="terms-of-service" locale={locale} />
</BaseLayout>
