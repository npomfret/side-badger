---
/**
 * The pricing page (restructure 6.4, site plan D2/D3/D19): one free offer, the real limits as a
 * table, the trust stamp, the terms' notice commitment and the FAQ. One call to action, through
 * the launch counter. Confetti loads on the first click, never at page load (D25).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import LaunchAppCta from './cta/LaunchAppCta.astro';
import ContentSection from './content/ContentSection.astro';
import FaqList from './content/FaqList.astro';
import { faqNode, webPageNode } from './content/layout-jsonld';
import { t, type Locale } from '../i18n';
import { localizedPath } from '../seo/urls';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const checkIcon = `<svg class="check" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>`;

// Receipt scanning (feature4) carries its disclosure, the note under the list (site plan D10)
const features = [
  t('pricing.free.feature1', locale),
  t('pricing.free.feature2', locale),
  t('pricing.free.feature3', locale),
  t('pricing.free.feature4', locale),
  t('pricing.free.feature5', locale),
  t('pricing.free.feature6', locale),
];

const limitRows = [
  { label: t('pricing.limits.people.label', locale), value: t('pricing.limits.people.value', locale) },
  { label: t('pricing.limits.records.label', locale), value: t('pricing.limits.records.value', locale) },
  { label: t('pricing.limits.amount.label', locale), value: t('pricing.limits.amount.value', locale) },
  { label: t('pricing.limits.currencies.label', locale), value: t('pricing.limits.currencies.value', locale) },
  { label: t('pricing.limits.receipts.label', locale), value: t('pricing.limits.receipts.value', locale) },
  { label: t('pricing.limits.attachments.label', locale), value: t('pricing.limits.attachments.value', locale) },
  { label: t('pricing.limits.lists.label', locale), value: t('pricing.limits.lists.value', locale) },
  { label: t('pricing.limits.polls.label', locale), value: t('pricing.limits.polls.value', locale) },
  { label: t('pricing.limits.scans.label', locale), value: t('pricing.limits.scans.value', locale) },
  { label: t('pricing.limits.protection.label', locale), value: t('pricing.limits.protection.value', locale) },
];

const faq = {
  heading: t('pricing.faq.title', locale),
  items: [
    { q: t('pricing.faq.q1.question', locale), a: t('pricing.faq.q1.answer', locale) },
    { q: t('pricing.faq.q2.question', locale), a: t('pricing.faq.q2.answer', locale) },
    { q: t('pricing.faq.q3.question', locale), a: t('pricing.faq.q3.answer', locale) },
    { q: t('pricing.faq.q4.question', locale), a: t('pricing.faq.q4.answer', locale) },
    { q: t('pricing.faq.q5.question', locale), a: t('pricing.faq.q5.answer', locale) },
    { q: t('pricing.faq.q6.question', locale), a: t('pricing.faq.q6.answer', locale) },
  ],
};

// The JSON-LD is built from the same items the page shows
const jsonLd = [webPageNode('pricing', locale), ...faqNode(faq)];
---

<BaseLayout
  page="pricing"
  title={t('pricing.meta.title', locale)}
  description={t('pricing.meta.description', locale)}
  locale={locale}
  jsonLd={jsonLd}
>
  <section class="pricing-hero" aria-labelledby="pricing-title">
    <div class="container text-center">
      <h1 id="pricing-title">{t('pricing.hero.title', locale)}</h1>
      <p class="price-subtitle">{t('pricing.hero.subtitle', locale)}</p>
      <p class="price-aside">{t('pricing.hero.aside', locale)}</p>
    </div>
  </section>

  <ContentSection heading={t('pricing.get.title', locale)} id="get" class="pricing-get">
    <article class="plan-card glass">
      <div class="plan-header">
        <p class="plan-price"><span class="amount">{t('pricing.free.price', locale)}</span></p>
        <p class="plan-description">{t('pricing.free.description', locale)}</p>
      </div>

      <ul class="plan-features" role="list">
        {features.map(feature => <li><Fragment set:html={checkIcon} /><span>{feature}</span></li>)}
      </ul>
      <p class="plan-note">{t('pricing.free.scanNote', locale)}</p>

      <LaunchAppCta target="register" cta="plan-free" pageId="pricing" locale={locale} class="btn-lg btn-full" confetti>
        {t('pricing.free.cta', locale)}
      </LaunchAppCta>
    </article>
  </ContentSection>

  <ContentSection heading={t('pricing.limits.title', locale)} id="limits" class="pricing-limits">
    <p class="section-lede">{t('pricing.limits.lede', locale)}</p>
    <div class="limits-scroll glass">
      <table class="limits-table">
        <caption class="sr-only">{t('pricing.limits.caption', locale)}</caption>
        <thead>
          <tr>
            <th scope="col">{t('pricing.limits.head.limit', locale)}</th>
            <th scope="col">{t('pricing.limits.head.value', locale)}</th>
          </tr>
        </thead>
        <tbody>
          {limitRows.map(row => (
            <tr>
              <th scope="row">{row.label}</th>
              <td>{row.value}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </ContentSection>

  <ContentSection heading={t('pricing.trust.title', locale)} id="trust" class="pricing-prose">
    <p>{t('pricing.trust.body', locale)}</p>
    <p><a href={localizedPath('privacy', locale)}>{t('home.trust.privacyLink', locale)}</a></p>
  </ContentSection>

  <ContentSection heading={t('pricing.stay.title', locale)} id="stay" class="pricing-prose">
    <p>{t('pricing.stay.body', locale)}</p>
    <p><a href={localizedPath('terms', locale)}>{t('pricing.stay.link', locale)}</a></p>
  </ContentSection>

  <FaqList faq={faq} locale={locale} />

  <script>
    // Confetti is a separate chunk that loads on the first click, not with the page (D25)
    document.querySelectorAll<HTMLElement>('.btn-confetti').forEach(link => {
      link.addEventListener(
        'click',
        async () => {
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          const { default: confetti } = await import('canvas-confetti');
          const rect = link.getBoundingClientRect();
          confetti({
            particleCount: 150,
            spread: 100,
            origin: {
              x: (rect.left + rect.width / 2) / window.innerWidth,
              y: (rect.top + rect.height / 2) / window.innerHeight,
            },
            colors: ['#7ec786', '#5fb0c4', '#f0c05c', '#4eeab5'],
            disableForReducedMotion: true,
          });
        },
        { once: true }
      );
    });
  </script>
</BaseLayout>

<style>
  @import '../styles/pricing.css';
</style>
