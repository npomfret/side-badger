---
/**
 * One expense card in scene 3's ledger: title, split type, the amount as it was paid, and an
 * optional aside. It drops in at stage 3 (`rise` from above); `from`/`to` are its native range.
 * With `card` the text is given outright and the card is still: content pages use it for their
 * hero art (`PageArt`), where the words come from the page's own worked example.
 */
import { t, type Locale, type TranslationKey } from '@/i18n';
import Avatar from '../Avatar.astro';
import type { Expense } from '../../data/example-group';
import { formatMoney } from '../../format';
import { expenseTitle, memberColor, memberName, SPLIT_KEYS } from './helpers';

interface Card {
  payer: string;
  /** An avatar colour (`MEMBERS[].color.light`) */
  color: string;
  title: string;
  split?: string;
  /** Already formatted; the card has no amount column without it */
  amount?: string;
}

interface Props {
  expense?: Expense;
  card?: Card;
  locale: Locale;
  from?: number;
  to?: number;
  index?: number;
}
const { expense, card, locale, from = 0, to = 0, index = 0 } = Astro.props;
if (!expense && !card) throw new Error('LedgerCard needs an expense or a card');
const content: Card = card ?? {
  payer: memberName(expense!.paidBy, locale),
  color: memberColor(expense!.paidBy),
  title: expenseTitle(expense!, locale),
  split: t(SPLIT_KEYS[expense!.split.kind], locale),
  amount: formatMoney(expense!.original.minor, expense!.original.currency, locale),
};
const note = card ? undefined : expense!.noteKey;
// A card animates only on the homepage, where it has an expense and a range
const motion = card
  ? {}
  : { 'data-anim': 'rise', 'data-at': 3, style: `--dy:-32px;--from:${from};--to:${to};--i:${index}` };
---

<li class="lc" {...motion}>
  <Avatar name={content.payer} color={content.color} size="2rem" />
  <div class="lc__body">
    <p class:list={['lc__head', { 'lc__head--dotted': card }]}>
      <strong>{content.title}</strong>
      {!card && content.split && <span class="lc__sep" aria-hidden="true">·</span>}
      {content.split && <span class:list={['lc__split', { 'lc__split--dotted': card }]}>{content.split}</span>}
    </p>
    {note && <p class="lc__note">{t(note as TranslationKey, locale)}</p>}
  </div>
  {content.amount && <bdi class="lc__amount">{content.amount}</bdi>}
</li>

<style>
  .lc {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.625rem;
    padding: 0.375rem 0.75rem;
    background: var(--paper, #fffdf8);
    border-radius: 6px;
    box-shadow: var(--paper-shadow);
    color: var(--ink, #1d2b24);
    list-style: none;
  }
  .lc__body {
    min-inline-size: 0;
  }
  .lc__head {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.375rem;
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.3;
  }
  .lc__split {
    color: var(--ink-muted, #4e5a52);
  }
  /* A card's split carries its own dot, in the space after the title. When the split wraps to a
     line of its own the dot falls outside the head and is clipped, so it never dangles. */
  .lc__head--dotted {
    overflow: clip;
  }
  .lc__head--dotted strong {
    margin-inline-end: 0.5rem;
  }
  .lc__split--dotted {
    position: relative;
  }
  .lc__split--dotted::before {
    content: '·';
    position: absolute;
    inset-inline-start: -0.875rem;
    inline-size: 0.875rem;
    text-align: center;
  }
  .lc__note {
    margin: 0.125rem 0 0;
    font-size: 0.8125rem;
    font-style: italic;
    color: var(--ink-muted, #4e5a52);
  }
  .lc__amount {
    font-weight: 700;
    font-size: 0.9375rem;
    white-space: nowrap;
  }
</style>
