---
import EasterEggs from '../components/EasterEggs.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import LanguageDetection from '../components/LanguageDetection.astro';
import SeoHead from '../components/layout/SeoHead.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import { t, isPseudoLocale, localeConfig, type Locale } from '../i18n';
import Breadcrumbs from '../components/nav/Breadcrumbs.astro';
import { breadcrumbJsonLd, breadcrumbsFor } from '../components/nav/navigation';
import type { PageId } from '../site/pages';
import type { JsonLdNode } from '../seo/jsonld';
import type { OgCardId } from '../pages/og/[card].png';

interface Props {
  /** Registry page id, or 'not-found'. Every route passes its own. */
  page: PageId | 'not-found';
  /** The page's own name in the breadcrumb (default: the title). Ancestors come from the registry. */
  breadcrumbName?: string;
  title: string;
  description?: string;
  locale?: Locale;
  /** Social card id (src/assets/og/*.png); defaults to `default` in SeoHead */
  ogCard?: OgCardId;
  /** Page-specific JSON-LD nodes; SeoHead adds the base nodes and merges by @id */
  jsonLd?: JsonLdNode[];
}

const {
  page,
  breadcrumbName,
  title,
  description: descriptionProp,
  locale = 'en',
  ogCard,
  jsonLd,
} = Astro.props;

const currentPath = Astro.url.pathname;
// One trail feeds the visible breadcrumb and the BreadcrumbList JSON-LD (restructure D22)
const crumbs = page === 'not-found' ? [] : breadcrumbsFor(page, locale, breadcrumbName ?? title);
const pageJsonLd = [...(jsonLd ?? []), ...breadcrumbJsonLd(crumbs)];
const description = descriptionProp ?? t('meta.description', locale);
const { htmlLang, dir } = localeConfig[locale];
// Preview pseudo-locales are built only under PREVIEW_PSEUDO=1 and must never ship
const pseudo = isPseudoLocale(locale);

// Fonts (restructure D24). Latin, Cyrillic and Greek faces are in global.css; Arabic-script and
// Indic locales link their own subset stylesheet; CJK uses system stacks.
const fontScript = localeConfig[locale]?.fontScript ?? 'latin';
// Each script's stylesheet and its one webfont, preloaded (F4) so the download starts with the HTML
// rather than after the stylesheet: every page in these locales sets its LCP text in that face.
const scriptFonts: Partial<Record<string, { css: string; woff2: string }>> = {
  arabic: { css: '/fonts/noto-sans-arabic.css', woff2: '/fonts/noto-sans-arabic-arabic-wght-normal.woff2' },
  devanagari: { css: '/fonts/noto-sans-devanagari.css', woff2: '/fonts/noto-sans-devanagari-devanagari-wght-normal.woff2' },
  bengali: { css: '/fonts/noto-sans-bengali.css', woff2: '/fonts/noto-sans-bengali-bengali-wght-normal.woff2' },
  telugu: { css: '/fonts/noto-sans-telugu.css', woff2: '/fonts/noto-sans-telugu-telugu-wght-normal.woff2' },
};
const scriptFont = scriptFonts[fontScript];
// D24: the two preloads are for Latin-script locales only. Cyrillic and Greek headings use Inter,
// so a Space Grotesk preload there would be fetched and never used.
const preloadLatin = fontScript === 'latin';
---

<!DOCTYPE html>
<html lang={htmlLang} dir={dir} data-font-script={fontScript} data-pseudo={pseudo ? '' : undefined}>
  <head>
    <SeoHead page={page} title={title} description={description} locale={locale} ogCard={ogCard} jsonLd={pageJsonLd}>
      <slot name="head" slot="head" />
    </SeoHead>
    {preloadLatin && (
      <>
        <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/space-grotesk-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
      </>
    )}
    {scriptFont && (
      <>
        <link rel="preload" href={scriptFont.woff2} as="font" type="font/woff2" crossorigin />
        <link rel="stylesheet" href={scriptFont.css} />
      </>
    )}
  </head>
  <body>
    <a href="#main-content" class="skip-link">{t('a11y.skipToContent', locale)}</a>
    <EasterEggs />
    {page !== 'not-found' && <LanguageDetection currentLocale={locale} />}

    <slot name="header">
      <SiteHeader locale={locale} currentPath={page === 'not-found' ? '/' : currentPath} pageId={page} />
    </slot>

    <main id="main-content">
      <Breadcrumbs crumbs={crumbs} locale={locale} />
      <slot />
    </main>

    <SiteFooter locale={locale} />

    <script>
      // Runtime motion preference listener
      const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
      const handleMotionPreference = (e: MediaQueryListEvent | MediaQueryList) => {
        document.body.classList.toggle('reduce-motion', e.matches);
      };
      handleMotionPreference(motionQuery);
      motionQuery.addEventListener('change', handleMotionPreference);

      // Scroll-triggered fade-up animations
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

      document.querySelectorAll('.fade-up').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
  @import '../styles/layout.css';
  @import '../styles/nav.css';
</style>
