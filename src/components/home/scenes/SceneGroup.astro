---
/**
 * Scene 2, group forms (`group`). Stages: 0 a place card on an empty table with five empty place
 * settings, 1 the phone with the invite screen slides in, 2 a link card reaches each place and
 * opens its sign-up (an email field), 3 the avatars sit down one by one, each with a "{name}
 * joined" toast, and the card reads "5 members". Reduced motion rests at stage 3: five avatars
 * seated, the phone showing the link and QR code.
 *
 * Motion is generic (`data-anim` + `data-at`), with per-element `--from` / `--to` for the pinned
 * native range and a staggered `--range` for the phone's entry range. Places fill from the
 * inline-start side (the grid flips in RTL) and the phone sits at inline-end.
 *
 * The sign-up chips are illustration (aria-hidden): a link card, an email field and a tick. The
 * email addresses are placeholders built from the cast ids.
 */
import ScrollScene from '../ScrollScene.astro';
import SceneLink from '../props/SceneLink.astro';
import Avatar from '../props/Avatar.astro';
import InvitePhone from '../props/chaos/InvitePhone.astro';
import { t, tf, type Locale } from '@/i18n';
import { MEMBERS } from '../data/example-group';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

// Native ranges: seats fill one by one (percent of the pinned range); on phones each element
// gets its own band of the entry range so the order is the same
const seats = MEMBERS.map((member, i) => ({
  member,
  name: t(member.nameKey, locale),
  email: `${member.id}@example.com`,
  chip: `--from:${27 + i * 5.5};--to:${38 + i * 5.5};--i:${i};--range:entry ${8 + i * 4}% entry ${28 + i * 4}%`,
  avatar: `--from:${60 + i * 4.5};--to:${68 + i * 4.5};--i:${i};--range:entry ${30 + i * 6}% entry ${50 + i * 6}%`,
  toast: `--from:${62 + i * 4.5};--to:${70 + i * 4.5};--i:${i};--range:entry ${34 + i * 6}% entry ${54 + i * 6}%`,
}));
---

<ScrollScene
  id="group"
  titleId="group-title"
  runway={{ desktop: 150, phone: 'entry' }}
  stages={[25, 60, 85]}
  staticStage={3}
>
  <Fragment slot="copy">
    <h2 id="group-title">{t('home.group.title', locale)}</h2>
    <p>{t('home.group.body', locale)}</p>
  </Fragment>

  <div slot="visual" class="group">
    <div class="group__card" data-prop="place-card">
      <p class="group__name">{t('home.group.name', locale)}</p>
      <p
        class="group__count"
        data-anim="fade"
        data-at="3"
        style="--from:84;--to:92;--range:entry 60% entry 85%"
      >{t('home.group.memberCount', locale)}</p>
    </div>

    <div
      class="group__phone"
      data-anim="slide"
      data-at="1"
      style="--from:3;--to:24;--dx:56px;--range:entry 0% entry 30%"
    >
      <InvitePhone locale={locale} />
    </div>

    <ul class="group__seats">
      {
        seats.map(seat => (
          <li class="seat">
            <div class="seat__chip" data-anim="rise" data-at="2" style={`${seat.chip};--dy:36px`} aria-hidden="true">
              <bdi dir="ltr">{seat.email}</bdi>
              <svg
                viewBox="0 0 12 12"
                class="seat__tick"
                data-anim="pop"
                data-at="3"
                style={seat.avatar}
                focusable="false"
              ><path d="M2 6.5l2.5 2.5L10 3" /></svg>
            </div>
            <div class="seat__spot">
              <span class="seat__plate" aria-hidden="true"></span>
              <span class="seat__avatar" data-anim="pop" data-at="3" style={`${seat.avatar};--s:0.4`}>
                <Avatar name={seat.name} color={seat.member.color.light} size="2.75rem" />
              </span>
            </div>
            <p class="seat__name">{seat.name}</p>
            <p class="seat__toast" data-anim="rise" data-at="3" style={`${seat.toast};--dy:10px`}>
              {tf('home.group.joined', { name: seat.name }, locale)}
            </p>
          </li>
        ))
      }
    </ul>
  </div>

  <Fragment slot="link"><SceneLink to="group" locale={locale} /></Fragment>
</ScrollScene>

<style>
  .group {
    --seat-min: 6.5rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 12.5rem);
    grid-template-areas:
      'card phone'
      'seats seats';
    gap: 1rem 1.5rem;
    align-items: start;
  }
  .group__card {
    grid-area: card;
    justify-self: start;
    align-self: center;
    min-inline-size: min(100%, 12rem);
    padding: 1rem 1.5rem;
    background: var(--paper, #fffdf8);
    box-shadow: var(--paper-shadow-lift);
    border-radius: 4px;
    rotate: -2deg;
    text-align: center;
  }
  .group__name {
    margin: 0;
    font-weight: 700;
    font-size: 1.375rem;
    color: var(--ink);
  }
  .group__count {
    margin: 0.25rem 0 0;
    font-size: 0.9375rem;
    color: var(--green-ink, #2f6b2e);
    font-weight: 600;
  }
  .group__phone {
    grid-area: phone;
    min-inline-size: 0;
  }
  .group__phone :global(.frame--phone) {
    inline-size: 100%;
    aspect-ratio: auto;
  }
  .group__seats {
    grid-area: seats;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--seat-min), 1fr));
    gap: 0.75rem;
  }
  .seat {
    display: grid;
    grid-template-rows: auto auto auto auto;
    justify-items: center;
    align-content: start;
    gap: 0.25rem;
    min-inline-size: 0;
  }
  .seat__chip {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    max-inline-size: 100%;
    padding: 0.3125rem 0.5rem;
    background: var(--app-surface, #fff);
    color: var(--app-ink, #1f2937);
    border: 1px solid #d1d5db;
    border-radius: 6px;
    box-shadow: var(--paper-shadow);
    font-size: 0.625rem;
    line-height: 1.2;
  }
  .seat__chip bdi {
    min-inline-size: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .seat__tick {
    position: absolute;
    inset-block-start: -0.4rem;
    inset-inline-end: -0.4rem;
    inline-size: 1rem;
    block-size: 1rem;
    padding: 0.1875rem;
    border-radius: 50%;
    background: var(--app-primary-dark, #15803d);
    fill: none;
    stroke: #fff;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .seat__spot {
    display: grid;
    place-items: center;
    inline-size: 3.5rem;
    block-size: 3.5rem;
  }
  .seat__spot > * {
    grid-area: 1 / 1;
  }
  .seat__plate {
    inline-size: 3.25rem;
    block-size: 3.25rem;
    border-radius: 50%;
    border: 2px dashed var(--ink-muted, #4e5a52);
    background: rgb(255 253 248 / 0.7);
  }
  .seat__avatar {
    display: grid;
  }
  .seat__name {
    margin: 0;
    font-weight: 600;
    font-size: 0.9375rem;
    text-align: center;
  }
  .seat__toast {
    margin: 0;
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    background: var(--app-tint, #f0fdf4);
    color: #14532d;
    border: 1px solid #86efac;
    font-size: 0.75rem;
    line-height: 1.3;
    text-align: center;
    overflow-wrap: anywhere;
  }

  /* Tablet and phone: copy, then the phone, then the places; the cards stack */
  @media (max-width: 599px) {
    .group {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'card'
        'phone'
        'seats';
    }
    .group__card {
      justify-self: center;
    }
    .group__phone {
      inline-size: min(100%, 14rem);
      justify-self: end;
    }
  }
</style>
