---
/**
 * Renders a content `richText` field (restructure 3.3, D11, D12): inline Markdown only, so no
 * block elements ever appear inside a heading, a button label or a card.
 *
 * `[text](page:<pageId>)` resolves to the page's localized path through `localizedPath`. A page
 * id that is not registered, or not built (unpublished), throws, which fails the build, so a
 * link can never dangle. `[text](https://app.sidebadger.me/…)` is the only external form.
 *
 * Usage: <RichText text={entry.data.lead} locale={locale} />
 * Pass `as="p"` to wrap the result in a paragraph; the default is a bare `<span>`.
 */
import { Marked, type Tokens } from 'marked';
import type { Locale } from '../../i18n';
import { localizedPath } from '../../seo/urls';
import { builtPages, getPage } from '../../site/pages';
import { PAGE_LINK_PREFIX, richTextProblem } from '../../content/schemas';

interface Props {
  text: string;
  locale: Locale;
  as?: 'span' | 'p';
  class?: string;
}

const { text, locale, as: tag = 'span', class: className } = Astro.props;

const problem = richTextProblem(text);
if (problem) throw new Error(`RichText: the text ${problem}: "${text.slice(0, 80)}"`);

const marked = new Marked({
  gfm: false,
  renderer: {
    link({ href, tokens }: Tokens.Link) {
      const label = this.parser.parseInline(tokens);
      if (href.startsWith(PAGE_LINK_PREFIX)) {
        const id = href.slice(PAGE_LINK_PREFIX.length);
        if (!getPage(id)) throw new Error(`RichText: unknown page id "${id}" in link "${href}"`);
        if (!builtPages().some(page => page.id === id)) {
          throw new Error(`RichText: page "${id}" is not published, so "${href}" would dangle`);
        }
        return `<a href="${localizedPath(id, locale)}">${label}</a>`;
      }
      return `<a href="${href}" rel="noopener">${label}</a>`;
    },
  },
});

const html = marked.parseInline(text) as string;
const Tag = tag;
---

<Tag class={className} set:html={html} />
