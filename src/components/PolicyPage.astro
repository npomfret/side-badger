---
import 'github-markdown-css/github-markdown-light.css';
import { getAppUrl, localeConfig, t, type Locale } from '../i18n';

interface Props {
  title: string;
  /** The app's policy id, e.g. `privacy-policy` (its API path is `/api/policies/<id>`). */
  policyId: 'privacy-policy' | 'terms-of-service' | 'cookie-policy';
  locale: Locale;
}

const { title, policyId, locale } = Astro.props;

// The app owns the policies. The build never calls this API: the visitor's browser does, when the page opens.
const apiBase = `${new URL(getAppUrl()).origin}/api/policies/${policyId}`;
const textUrl = `${apiBase}/text`;
const currentUrl = `${apiBase}/current`;

const strings = {
  loading: t('policy.loading', locale),
  error: t('policy.error', locale),
  updated: t('policy.lastUpdated', locale),
};
const isEnglish = locale === 'en';
---

<section class="legal-page" aria-labelledby="policy-title">
  <div class="container">
    <div
      class="legal-content glass fade-up"
      data-policy
      data-text-url={textUrl}
      data-current-url={currentUrl}
      data-intl-code={localeConfig[locale].intlCode}
      data-strings={JSON.stringify(strings)}
    >
      <h1 id="policy-title" class="policy-title">{title}</h1>
      <p class="policy-updated" data-ref="updated" hidden><time data-ref="time"></time></p>
      {!isEnglish && <p class="policy-notice" role="note">{t('policy.englishOnly', locale)}</p>}
      <div class="policy-state" role="status" aria-live="polite">
        <p data-ref="message" tabindex="-1"></p>
        <button type="button" class="btn btn-secondary" data-ref="retry" hidden>{t('policy.retry', locale)}</button>
      </div>
      <noscript>
        <p class="policy-notice" role="note">
          {t('policy.noscript', locale)} <a href={textUrl} rel="noopener noreferrer">{t('policy.sourceLink', locale)}</a>
        </p>
      </noscript>
      <div class="policy-content markdown-body" data-ref="body" lang="en" dir="ltr" aria-busy="true" tabindex="-1" hidden></div>
    </div>
  </div>
</section>

<script>
  import './policy/policy-page';
</script>

<style>
  @import '../styles/policy.css';
</style>
