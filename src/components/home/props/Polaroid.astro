---
/**
 * A polaroid of a group member: avatar in the frame, translated name underneath. The default
 * slot sits under the name (a balance tag, say). The name is real text; the avatar is
 * decoration.
 */
import type { HTMLAttributes } from 'astro/types';
import Avatar from './Avatar.astro';

interface Props extends HTMLAttributes<'figure'> {
  name: string;
  color: string;
  rotate?: number;
}

const { name, color, rotate = 0, class: className, style, ...rest } = Astro.props;
const tilt = rotate ? `--rot:${rotate}deg` : '';
---

<figure
  {...rest}
  class:list={['polaroid', className]}
  data-prop="polaroid"
  style={[tilt, style].filter(Boolean).join(';') || undefined}
>
  <div class="polaroid__photo"><Avatar name={name} color={color} size="3.25rem" /></div>
  <figcaption>
    <span class="polaroid__name">{name}</span>
    <slot />
  </figcaption>
</figure>

<style>
  .polaroid {
    margin: 0;
    padding: 0.5rem 0.5rem 0.625rem;
    background: var(--paper, #fffdf8);
    box-shadow: var(--paper-shadow);
    rotate: var(--rot, 0deg);
    inline-size: 5.5rem;
    text-align: center;
    min-inline-size: 0;
  }
  .polaroid__photo {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    background: var(--app-tint, #f0fdf4);
  }
  figcaption {
    margin-block-start: 0.375rem;
    font-size: 0.8125rem;
    line-height: 1.25;
  }
  .polaroid__name {
    display: block;
    font-weight: 600;
  }
</style>
