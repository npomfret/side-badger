---
/**
 * The app's add-expense form (`ExpenseFormModal` with receipt scanning) as an illustration inside a
 * phone frame. Description, amount and date arrive from the receipt as strips (`slide`), and each
 * is ticked off as the visitor's check. Who paid and how to split were already chosen.
 * Motion hooks: values and ticks are data-at 2; the scanning line is `.exp-win` (visible only
 * while the receipt is being read; its motion lives in SceneExpenses).
 */
import { t, type Locale } from '@/i18n';
import AppFrame from '../../AppFrame.astro';
import { formatMoney } from '../../format';
import { expenseById, expenseTitle, memberName, receiptDate, SPLIT_KEYS } from './helpers';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const dinner = expenseById(4);
const fields = [
  { label: t('home.expenses.fieldDescription', locale), value: expenseTitle(dinner, locale), money: false },
  {
    label: t('home.expenses.fieldAmount', locale),
    value: formatMoney(dinner.original.minor, dinner.original.currency, locale),
    money: true,
  },
  { label: t('home.expenses.fieldDate', locale), value: receiptDate(locale), money: false },
];
// Native ranges (percent of the pinned range) for strips and ticks; all end by the stage-2 boundary (50)
const strips = [
  { from: 36, to: 43 },
  { from: 38, to: 45 },
  { from: 40, to: 47 },
];
const ticks = [
  { from: 43, to: 47 },
  { from: 45, to: 49 },
  { from: 47, to: 50 },
];
const splits = ['equal', 'exact', 'percent'] as const;
---

<AppFrame variant="phone" class="aef">
  <p class="aef__status exp-win">
    <span class="aef__dot" aria-hidden="true"></span>{t('home.expenses.scanning', locale)}
  </p>
  {
    fields.map((field, i) => (
      <div class="app-field aef__field">
        <span>{field.label}</span>
        <span class="aef__row">
          <span
            class="aef__val"
            data-anim="slide"
            data-at="2"
            style={`--dx:-90px;--from:${strips[i].from};--to:${strips[i].to};--i:${i}`}
          >
            {field.money ? <bdi>{field.value}</bdi> : field.value}
          </span>
          <svg class="aef__tick" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
            <path
              d="M3 11l5 5L17 5"
              data-anim="draw"
              data-at="2"
              style={`--L:26;--from:${ticks[i].from};--to:${ticks[i].to};--i:${i + 3}`}
            />
          </svg>
        </span>
      </div>
    ))
  }
  <div class="app-field aef__field">
    <span>{t('home.expenses.fieldPaidBy', locale)}</span>
    <span class="aef__val">{memberName(dinner.paidBy, locale)}</span>
  </div>
  <div class="aef__split">
    <span class="aef__split-label">{t('home.expenses.fieldSplit', locale)}</span>
    <span class="aef__chips">
      {
        splits.map((kind) => (
          <span class:list={['aef__chip', { 'is-on': kind === dinner.split.kind }]}>
            {t(SPLIT_KEYS[kind], locale)}
          </span>
        ))
      }
    </span>
  </div>
</AppFrame>

<style>
  .aef :global(.frame__screen) {
    gap: 0.375rem;
  }
  .aef:global(.frame--phone) {
    aspect-ratio: auto;
    inline-size: 100%;
    max-inline-size: 17.5rem;
  }
  @media (max-width: 599px) {
    .aef :global(.frame__screen) {
      gap: 0.25rem;
      padding: 0.5rem 0.625rem;
      padding-block-start: 1.375rem;
    }
    .aef :global(.app-field) {
      padding: 0.25rem 0.5rem;
    }
    .aef:global(.frame--phone) {
      padding: 0.5rem;
    }
  }
  .aef__status {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin: 0;
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    background: var(--app-tint);
    color: var(--app-primary-dark);
    font-weight: 600;
    font-size: 0.75rem;
  }
  .aef__dot {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    flex: none;
    border-radius: 50%;
    background: var(--app-primary);
  }
  .aef__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-block-size: 1.25rem;
  }
  .aef__val {
    font-weight: 600;
    min-inline-size: 0;
  }
  .aef__tick {
    inline-size: 1.125rem;
    block-size: 1.125rem;
    flex: none;
    fill: none;
    stroke: var(--app-primary-dark);
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .aef__split {
    display: grid;
    gap: 0.25rem;
  }
  .aef__split-label {
    font-size: 0.6875rem;
    color: #4b5563;
  }
  .aef__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  .aef__chip {
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    border: 1px solid #d1d5db;
    font-size: 0.6875rem;
    color: #374151;
  }
  .aef__chip.is-on {
    background: var(--app-primary-dark);
    border-color: var(--app-primary-dark);
    color: #fff;
  }
</style>
