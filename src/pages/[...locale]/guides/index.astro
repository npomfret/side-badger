---
// The guides hub (release 2 plan R4). The content entry is `pages/guides/<locale>.yaml`.
import HubLayout from '../../../layouts/HubLayout.astro';
import { layoutPaths, loadPageContent } from '../../../components/content/page-content';
import type { SitePageData } from '../../../content/schemas';
import type { Locale } from '../../../i18n';

export async function getStaticPaths() {
  return layoutPaths('hub', id => id === 'guides');
}

const { pageId, locale } = Astro.props as { pageId: string; locale: Locale };
const data = await loadPageContent<Extract<SitePageData, { cardsHeading: string }>>(pageId, locale);
---

<HubLayout data={data} pageId={pageId} locale={locale} />
