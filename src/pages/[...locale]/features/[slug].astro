---
// A feature page (restructure 6.1). The content entry is `features/<slug>/<locale>.yaml`.
import FeaturePageLayout from '../../../layouts/FeaturePageLayout.astro';
import { layoutPaths, loadPageContent } from '../../../components/content/page-content';
import type { FeaturePageData } from '../../../content/schemas';
import type { Locale } from '../../../i18n';

export async function getStaticPaths() {
  return layoutPaths('feature');
}

const { pageId, locale } = Astro.props as { pageId: string; locale: Locale };
const data = await loadPageContent<FeaturePageData>(pageId, locale);
---

<FeaturePageLayout data={data} pageId={pageId} locale={locale} />
