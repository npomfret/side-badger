---
// A guide (release 2 plan R4). The content entry is `guides/<slug>/<locale>.yaml`.
import GuidePageLayout from '../../../layouts/GuidePageLayout.astro';
import { layoutPaths, loadPageContent } from '../../../components/content/page-content';
import type { GuideData } from '../../../content/schemas';
import type { Locale } from '../../../i18n';

export async function getStaticPaths() {
  return layoutPaths('article');
}

const { pageId, locale } = Astro.props as { pageId: string; locale: Locale };
const data = await loadPageContent<GuideData>(pageId, locale);
---

<GuidePageLayout data={data} pageId={pageId} locale={locale} />
