---
/**
 * The mobile menu (restructure 5.2, D21): a Menu button and a Popover API panel, no script.
 * Escape, light dismiss, the top layer and returning focus come from the browser. Where popover
 * is unsupported, nav.css shows the panel as a plain list and hides the button. The panel opens
 * with a labelled Sign in link, since the header shows only its icon on phones.
 */
import Icon from '@/components/icons/Icon.astro';
import Tooltip from '@/components/controls/Tooltip.astro';
import LaunchAppCta from '../cta/LaunchAppCta.astro';
import { t, type Locale } from '../../i18n';
import type { NavLink } from '../nav/navigation';

interface Props {
  links: readonly NavLink[];
  locale: Locale;
  /** The registry page the menu is on, for the launch counter */
  pageId: string;
}

const { links, locale, pageId } = Astro.props;
---

{links.length > 0 && (
  <div class="mobile-nav">
    <Tooltip text={t('nav.menu', locale)} side="block-end" align="end" narrow="small-phone">
      <button type="button" class="menu-button" popovertarget="site-menu" aria-controls="site-menu">
        <Icon name="menu" size="md" class="menu-button__icon" />
        <span class="menu-button__text">{t('nav.menu', locale)}</span>
      </button>
    </Tooltip>
    <div id="site-menu" class="mobile-menu" popover>
      <LaunchAppCta target="app" cta="menu" pageId={pageId} locale={locale} class="mobile-menu__sign-in" />
      <nav aria-label={t('a11y.mainNavigation', locale)}>
        <ul role="list">
          {links.map(link => (
            <li><a href={link.href} aria-current={link.current}>{link.label}</a></li>
          ))}
        </ul>
      </nav>
      <button type="button" class="menu-close" popovertarget="site-menu" popovertargetaction="hide">
        {t('nav.closeMenu', locale)}
      </button>
    </div>
  </div>
)}
