---
/**
 * The app's add-expense form (`ExpenseFormModal` with receipt scanning) as an illustration inside a
 * phone frame. Filled by default. `scan` (the scanned receipt's description and amount) turns it
 * into the receipt-scanning form: the camera view (`ScanViewfinder`) over the screen with the
 * scanning message, an attachment thumbnail with the review message, and field markers.
 *
 * The caller maps its stages to inherited semantic hooks; defaults rest on the filled review
 * state, and this prop knows nothing of scene stages or playback engines:
 *   --scan-fields-opacity / --scan-fields-offset        scanned fields, their ticks and the thumbnail
 *   --scan-review-opacity / --scan-review-visibility    the review message
 *   --scan-scanning-opacity / --scan-scanning-visibility the scanning message
 *   --scan-transition-ms / --scan-stagger-ms            fade length and the delay between fields
 * plus ScanViewfinder's own hooks. Who paid and how to split were already chosen. The phone's width
 * is the caller's (`--frame-phone-width`, AppFrame's sizing contract); the camera view is the
 * frame's overlay layer, so the form keeps the screen's height in every stage. All motion is
 * transforms and opacity.
 */
import { t, type Locale } from '@/i18n';
import AppFrame from '../../AppFrame.astro';
import Receipt from '../Receipt.astro';
import Icon from '@/components/icons/Icon.astro';
import ScanViewfinder from './ScanViewfinder.astro';
import { formatMoney } from '../../format';
import { expenseById, expenseTitle, memberName, receiptDate, SPLIT_KEYS } from './helpers';

interface Props {
  locale: Locale;
  scan?: { description: string; amount: string };
}
const { locale, scan } = Astro.props;

const dinner = expenseById(4);
const fields = [
  { label: t('home.expenses.fieldDescription', locale), value: scan?.description ?? expenseTitle(dinner, locale), money: false },
  {
    label: t('home.expenses.fieldAmount', locale),
    value: scan?.amount ?? formatMoney(dinner.original.minor, dinner.original.currency, locale),
    money: true,
  },
  { label: t('home.expenses.fieldDate', locale), value: receiptDate(locale), money: false },
];
const splits = ['equal', 'exact', 'percent'] as const;
---

<AppFrame variant="phone" fit="content" density="compact" class:list={['aef', { 'aef--scan': scan }]}>
  <div class="aef__body">
    {scan && <div class="aef__attached">
      <Receipt size="thumb" decorative class="aef__thumb" title={scan.description} total={{ label: '', amount: scan.amount }} />
      <p class="aef__status aef__review">{t('home.hero.scanReview', locale)}</p>
    </div>}
    {
      fields.map((field, i) => (
        <div class:list={['app-field', 'aef__field', { 'aef__field--review': scan }]}>
          <span>{field.label}</span>
          <span class="aef__row">
            <span
              class:list={['aef__val', { 'aef__landing': scan }]}
              data-testid={scan ? 'scan-field' : undefined}
              style={scan ? `--i:${i}` : undefined}
            >
              {field.money ? <bdi>{field.value}</bdi> : field.value}
            </span>
            {scan && <Icon name="check" size="sm" class="aef__tick" data-testid="scan-check" style={`--i:${i}`} />}
          </span>
        </div>
      ))
    }
    <div class="app-field aef__field">
      <span>{t('home.expenses.fieldPaidBy', locale)}</span>
      <span class="aef__val">{memberName(dinner.paidBy, locale)}</span>
    </div>
    <div class="aef__split">
      <span class="aef__split-label">{t('home.expenses.fieldSplit', locale)}</span>
      <span class="aef__chips">
        {
          splits.map((kind) => (
            <span class:list={['aef__chip', { 'is-on': kind === dinner.split.kind }]}>
              {t(SPLIT_KEYS[kind], locale)}
            </span>
          ))
        }
      </span>
    </div>
  </div>
  {scan && <Fragment slot="overlay">
    <ScanViewfinder locale={locale} title={scan.description} amount={scan.amount}>
      <p class="aef__status aef__scanning"><span class="aef__dot" aria-hidden="true"></span>{t('home.expenses.scanning', locale)}</p>
    </ScanViewfinder>
  </Fragment>}
</AppFrame>

<style>
  .aef__attached {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  .aef__thumb {
    flex: none;
    inline-size: 3.25rem;
    opacity: var(--scan-fields-opacity, 1);
    transition: opacity var(--scan-transition-ms, 0s) linear;
  }
  .aef__scanning {
    opacity: var(--scan-scanning-opacity, 0);
    visibility: var(--scan-scanning-visibility, hidden);
  }
  .aef__review {
    opacity: var(--scan-review-opacity, 1);
    visibility: var(--scan-review-visibility, visible);
  }
  .aef__field--review { border-style: dashed; }
  .aef__landing {
    opacity: var(--scan-fields-opacity, 1);
    transform: translateX(calc(var(--scan-fields-offset, 0rem) * var(--dir)));
    transition: opacity var(--scan-transition-ms, 0s) linear, transform var(--scan-transition-ms, 0s) var(--ease-paper);
    transition-delay: calc(var(--i, 0) * var(--scan-stagger-ms, 0s));
  }
  /* Each tick pops in just after its field lands */
  .aef__tick {
    opacity: var(--scan-fields-opacity, 1);
    transform: scale(calc(0.4 + 0.6 * var(--scan-fields-opacity, 1)));
    transition: opacity var(--scan-transition-ms, 0s) linear, transform var(--scan-transition-ms, 0s) var(--ease-snap);
    transition-delay: calc((var(--i, 0) + 2) * var(--scan-stagger-ms, 0s));
  }
  :is(.aef__review, .aef__scanning) {
    /* Visibility hides at the end of the fade and becomes visible at its start. */
    transition: opacity var(--scan-transition-ms, 0s) linear, visibility var(--scan-transition-ms, 0s) linear;
  }
  .aef__body {
    display: grid;
    gap: 0.375rem;
  }
  .aef--scan .aef__body {
    gap: 0.5rem;
    font-size: 0.875rem;
  }
  @media (max-width: 599px) {
    .aef__body {
      gap: 0.25rem;
    }
    .aef__field {
      padding: 0.25rem 0.5rem;
    }
  }
  .aef__status {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin: 0;
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    background: var(--app-tint);
    color: var(--app-primary-dark);
    font-weight: 600;
    font-size: 0.75rem;
  }
  .aef__dot {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    flex: none;
    border-radius: 50%;
    background: var(--app-primary);
  }
  .aef__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-block-size: 1.25rem;
  }
  .aef__val {
    font-weight: 600;
    min-inline-size: 0;
  }
  /* Stroke as before the move to Icon: 2.6 in a 20-unit box is about 3.1 in Icon's 24 */
  .aef__tick {
    --icon-stroke: 3.1;
    color: var(--app-primary-dark);
  }
  .aef__split {
    display: grid;
    gap: 0.25rem;
  }
  .aef__split-label {
    font-size: 0.6875rem;
    color: #4b5563;
  }
  .aef__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  .aef__chip {
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    border: 1px solid #d1d5db;
    font-size: 0.6875rem;
    color: #374151;
  }
  .aef__chip.is-on {
    background: var(--app-primary-dark);
    border-color: var(--app-primary-dark);
    color: #fff;
  }
</style>
