---
/**
 * A guide (release 2 plan R4): the hero (the reader's question as the h1, the answer as the lead),
 * the sections that tell the story of one fictional group, the worked example after
 * `exampleAfter` of them, an optional FAQ, the product pages the guide draws on, and the closing
 * call to action (launch counter position `guide-end`).
 *
 * `data` is the guide's content entry for the locale, already validated by `guide`; see
 * FeaturePageLayout for how it is loaded. JSON-LD: WebPage (about the app), Article, FAQPage for
 * the visible FAQ, and the BreadcrumbList BaseLayout builds from the registry. No `HowTo` (R4).
 */
import BaseLayout from './BaseLayout.astro';
import CtaBand from '../components/content/CtaBand.astro';
import ExtraSections from '../components/content/ExtraSections.astro';
import FaqList from '../components/content/FaqList.astro';
import PageHero from '../components/content/PageHero.astro';
import RelatedPages from '../components/content/RelatedPages.astro';
import WorkedExample from '../components/content/WorkedExample.astro';
import { articleNode, faqNode, webPageNode } from '../components/content/layout-jsonld';
import { relatedCards } from '../components/content/page-content';
import type { GuideData } from '../content/schemas';
import type { Locale } from '../i18n';
import { requirePage, type PageId } from '../site/pages';

interface Props {
  data: GuideData;
  pageId: string;
  locale: Locale;
}

const { data, pageId, locale } = Astro.props;
const page = requirePage(pageId);
const related = await relatedCards(pageId, locale);
---

<BaseLayout
  page={pageId as PageId}
  title={data.meta.title}
  description={data.meta.description}
  locale={locale}
  ogCard="use-cases"
  breadcrumbName={data.h1}
  jsonLd={[
    webPageNode(pageId, locale),
    articleNode({
      headline: data.h1,
      datePublished: data.datePublished,
      dateModified: data.dateModified ?? data.datePublished,
      locale,
    }),
    ...faqNode(data.faq),
  ]}
>
  <article class="content-page" data-page-type="guide" data-unpublished={page.published ? undefined : ''}>
    <PageHero h1={data.h1} lead={data.lead} pageId={pageId} locale={locale} />

    {data.example ? (
      <>
        <ExtraSections sections={data.sections} locale={locale} to={data.exampleAfter ?? 0} />
        <WorkedExample example={data.example} locale={locale} />
        <ExtraSections sections={data.sections} locale={locale} from={data.exampleAfter ?? 0} />
      </>
    ) : (
      <ExtraSections sections={data.sections} locale={locale} />
    )}

    {data.faq && <FaqList faq={data.faq} locale={locale} />}

    <RelatedPages links={related} locale={locale} />

    <CtaBand cta={data.cta} pageId={pageId} locale={locale} position="guide-end" />
  </article>
</BaseLayout>
