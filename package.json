{
  "name": "side-badger",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "scripts/dev.sh",
    "dev:host": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest",
    "docker:start": "docker compose -f docker-compose.yml -f docker-compose.local.yml -f docker-compose.watch.yml up --build -d && docker compose -f docker-compose.yml -f docker-compose.local.yml -f docker-compose.watch.yml watch",
    "docker:stop": "docker compose -f docker-compose.yml -f docker-compose.local.yml -f docker-compose.watch.yml down",
    "docker:restart": "scripts/dev.sh",
    "docker:logs": "docker logs -f side-badger-website",
    "i18n": "node scripts/i18n-manager.mjs",
    "i18n:list": "node scripts/i18n-manager.mjs list",
    "i18n:audit": "node scripts/i18n-manager.mjs audit",
    "i18n:stats": "node scripts/i18n-manager.mjs stats",
    "i18n:sync": "node scripts/i18n-manager.mjs sync",
    "check:site": "vitest run --config vitest.site.config.ts",
    "check:nginx": "scripts/check-nginx.sh",
    "policies:sync": "node scripts/sync-policies.mjs",
    "test:e2e": "playwright test",
    "verify": "npm test -- --run && npm run i18n:audit && astro check && npm run build && npm run check:site"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@fontsource-variable/noto-sans-bengali": "^5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "^5.3.0",
    "@fontsource-variable/noto-sans-telugu": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "astro": "^5.0.0",
    "canvas-confetti": "^1.9.3",
    "github-markdown-css": "^5.8.1",
    "lucide-astro": "^0.468.0",
    "marked": "^17.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@types/canvas-confetti": "^1.6.4",
    "cheerio": "^1.2.0",
    "js-yaml": "^5.4.3",
    "schema-dts": "^2.1.0",
    "sharp": "^0.35.5",
    "typescript": "^5.7.2",
    "vitest": "^4.0.15"
  }
}
