---
/**
 * A feature page's limits (restructure 3.3): always visible, never folded away or turned into a
 * joke. A plain list under its own `h2`.
 */
import type { Locale } from '../../i18n';
import ContentSection from './ContentSection.astro';
import RichText from './RichText.astro';

interface Props {
  limits: { heading: string; items: readonly string[] };
  locale: Locale;
}

const { limits, locale } = Astro.props;
---

<ContentSection heading={limits.heading} id="limits">
  <ul class="limits-list">
    {limits.items.map(item => (
      <li><RichText text={item} locale={locale} /></li>
    ))}
  </ul>
</ContentSection>

<style>
  .limits-list {
    margin: 0;
    padding-inline-start: var(--space-lg);
    display: grid;
    gap: var(--space-sm);
    max-inline-size: 70ch;
  }
</style>
