---
/**
 * A worked example (restructure 3.4, D23). Every number on it is computed here, at build time,
 * from the example data in the content entry with `computeExample` (`src/lib/settle.ts`), so the
 * balances and payments in 39 languages cannot drift from the arithmetic.
 *
 * - One currency: the expenses (with each person's share), the net balances, the payments Side
 *   Badger suggests, and, when that is a shorter list, the payments it replaces (paying each
 *   person back directly: the "before" of the settle-up diagram).
 * - Conversion (`conversion.rates`): both views the briefs call for. The currencies kept separate
 *   (one ledger each, never netted against each other) and the converted ledger, with each
 *   illustrative rate labelled as such.
 */
import { computeExample, type Ledger } from '../../lib/settle';
import type { WorkedExampleData } from '../../content/schemas';
import { localeConfig, t, type Locale } from '../../i18n';
import { moneyFormatter } from './money';
import { uiString } from './ui-strings';

interface Props {
  example: WorkedExampleData;
  locale: Locale;
  /** Unique on the page */
  id?: string;
}

const { example, locale, id = 'worked-example' } = Astro.props;
const { heading, ...data } = example;

const result = computeExample(data);
const money = moneyFormatter(localeConfig[locale].intlCode);
const names = Object.fromEntries(example.people.map(person => [person.id, person.name]));
const converted = example.conversion !== undefined;

const splitWord = {
  equal: t('example.splitEqual', locale),
  exact: t('example.splitExact', locale),
  percent: t('example.splitPercent', locale),
} as const;

const currencyName = (code: string) => {
  try {
    return new Intl.DisplayNames(localeConfig[locale].intlCode, { type: 'currency' }).of(code) ?? code;
  } catch {
    return code;
  }
};

const expenses = example.expenses.map((expense, index) => {
  const currency = expense.currency ?? example.currency;
  const participants = Object.entries(result.shares[index]).filter(([, minor]) => minor > 0);
  return {
    paid: uiString('example.paid', locale, {
      payer: names[expense.payer],
      amount: money.major(expense.amount, currency),
      item: expense.label,
    }),
    split: uiString('example.split', locale, {
      method: splitWord[expense.split.method],
      count: participants.length,
    }),
    // Shares are in the main ledger's currency, so a conversion example leaves them to the views
    shares: converted
      ? []
      : participants.map(([person, minor]) => ({
          name: names[person],
          amount: money.minor(minor, example.currency),
        })),
  };
});

const rates = Object.entries(example.conversion?.rates ?? {}).map(([from, rate]) => ({
  text: uiString('example.illustrativeRate', locale, {
    from: money.major(1, from),
    to: money.major(rate, example.currency),
  }),
}));

function view(ledger: Ledger) {
  return {
    currency: ledger.currency,
    balances: Object.entries(ledger.balances).map(([person, minor]) => ({
      name: names[person],
      amount: money.minor(minor, ledger.currency, { signed: true }),
    })),
    transfers: ledger.transfers.map(transfer =>
      uiString('example.transfer', locale, {
        from: names[transfer.from],
        to: names[transfer.to],
        amount: money.minor(transfer.minor, ledger.currency),
      })
    ),
    // The "before": only worth showing when the short list really is shorter
    pairwise:
      ledger.pairwise.length > ledger.transfers.length
        ? ledger.pairwise.map(transfer =>
            uiString('example.transfer', locale, {
              from: names[transfer.from],
              to: names[transfer.to],
              amount: money.minor(transfer.minor, ledger.currency),
            })
          )
        : [],
  };
}

const views = converted
  ? [
      {
        key: 'separate',
        title: uiString('example.separate', locale),
        ledgers: result.separate.map(view),
      },
      {
        key: 'converted',
        title: uiString('example.converted', locale, { currency: example.currency }),
        ledgers: [view(result)],
      },
    ]
  : [{ key: 'single', title: undefined, ledgers: [view(result)] }];
const showCurrencyNames = converted;
const headingId = `${id}-heading`;
---

<section class="worked-example" aria-labelledby={headingId} data-example-transfers={result.transfers.length}>
  <div class="container">
    {heading
      ? <h2 id={headingId}>{heading}</h2>
      : <h2 id={headingId} class="sr-only">{uiString('example.expenses', locale)}</h2>}
    <div class="we-card glass">
      <h3>{uiString('example.expenses', locale)}</h3>
      <ul class="we-expenses" role="list">
        {expenses.map(expense => (
          <li>
            <p class="we-paid">{expense.paid}</p>
            <p class="we-split">{expense.split}</p>
            {expense.shares.length > 0 && (
              <ul class="we-shares" role="list">
                {expense.shares.map(share => (
                  <li><span class="we-person">{share.name}</span> <span class="we-amount">{share.amount}</span></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>

      {rates.length > 0 && (
        <ul class="we-rates" role="list">
          {rates.map(rate => <li>{rate.text}</li>)}
        </ul>
      )}

      {views.map(v => (
        <div class="we-view" data-view={v.key}>
          {v.title && <h3 class="we-view-title" id={`${id}-${v.key}`}>{v.title}</h3>}
          {v.ledgers.map(ledger => {
            const prefix = [v.title ? `${id}-${v.key}` : '', showCurrencyNames && v.key === 'separate' ? `${id}-${v.key}-${ledger.currency}` : ''].filter(Boolean).join(' ');
            const labelled = (own: string) => [prefix, `${id}-${v.key}-${ledger.currency}-${own}`].filter(Boolean).join(' ');
            return (
            <div class="we-ledger">
              {showCurrencyNames && v.key === 'separate' && <h4 class="we-currency" id={`${id}-${v.key}-${ledger.currency}`}>{currencyName(ledger.currency)}</h4>}
              <div class="we-columns">
                <div>
                  <h4 id={`${id}-${v.key}-${ledger.currency}-balances`}>{uiString('example.balances', locale)}</h4>
                  <dl class="we-balances">
                    {ledger.balances.map(balance => (
                      <div>
                        <dt>{balance.name}</dt>
                        <dd>{balance.amount}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
                {ledger.pairwise.length > 0 && (
                  <div class="we-before">
                    <h4 id={`${id}-${v.key}-${ledger.currency}-pairwise`}>{uiString('example.pairwise', locale)}</h4>
                    <ol aria-labelledby={labelled('pairwise')}>{ledger.pairwise.map(line => <li>{line}</li>)}</ol>
                  </div>
                )}
                <div class="we-after">
                  <h4 id={`${id}-${v.key}-${ledger.currency}-transfers`}>{t('example.transfers', locale)}</h4>
                  {ledger.transfers.length > 0
                    ? <ol aria-labelledby={labelled('transfers')}>{ledger.transfers.map(line => <li>{line}</li>)}</ol>
                    : null}
                </div>
              </div>
            </div>
            );
          })}
        </div>
      ))}

      <p class="we-hint">{uiString('example.balanceHint', locale)}</p>
      <p class="we-note">{t('example.note', locale)}</p>
    </div>
  </div>
</section>

<style>
  .worked-example {
    padding-block: var(--space-2xl);
  }

  .worked-example h2 {
    margin-block-end: var(--space-lg);
  }

  .we-card {
    padding: var(--space-xl);
  }

  .we-card h3 {
    font-size: var(--text-xl);
    margin-block: 0 var(--space-md);
  }

  .we-card h4 {
    font-size: var(--text-base);
    margin-block: 0 var(--space-sm);
    color: var(--text-heading);
  }

  ul[role='list'],
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .we-expenses {
    display: grid;
    gap: var(--space-md);
  }

  .we-expenses > li {
    padding-block-end: var(--space-md);
    border-block-end: 1px solid var(--glass-border);
  }

  .we-paid {
    margin: 0;
    font-weight: 600;
    color: var(--text-heading);
    overflow-wrap: anywhere;
  }

  .we-split {
    margin: var(--space-xs) 0 0;
    color: var(--text-secondary);
    overflow-wrap: anywhere;
  }

  .we-shares {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    margin-block-start: var(--space-sm);
    font-size: var(--text-sm);
  }

  .we-person {
    color: var(--text-secondary);
  }

  .we-amount {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  .we-rates {
    margin-block-start: var(--space-md);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent-ink);
  }

  .we-view {
    margin-block-start: var(--space-xl);
  }

  .we-view-title {
    padding-block-start: var(--space-md);
    border-block-start: 1px solid var(--glass-border);
  }

  .we-ledger + .we-ledger {
    margin-block-start: var(--space-lg);
  }

  .we-columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
    gap: var(--space-lg);
  }

  .we-balances {
    margin: 0;
    display: grid;
    gap: var(--space-xs);
  }

  .we-balances > div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .we-balances dt {
    overflow-wrap: anywhere;
  }

  .we-balances dd {
    margin: 0;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .we-before ol,
  .we-after ol {
    display: grid;
    gap: var(--space-xs);
    counter-reset: payment;
  }

  .we-before li,
  .we-after li {
    overflow-wrap: anywhere;
    counter-increment: payment;
  }

  .we-after li {
    font-weight: 600;
    color: var(--accent-ink);
  }

  .we-hint,
  .we-note {
    margin: var(--space-lg) 0 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .we-hint {
    color: var(--text-secondary);
  }

  .we-note {
    margin-block-start: var(--space-xs);
  }
</style>
