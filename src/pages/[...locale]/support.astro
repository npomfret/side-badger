---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/content/PageHero.astro';
import { t, type Locale } from '../../i18n';
import { pathsFor } from '../../site/routes';

export function getStaticPaths() {
  return pathsFor('support');
}

const { locale } = Astro.props as { locale: Locale };
---

<BaseLayout
  page="support"
  locale={locale}
  title={`${t('support.title', locale)} | Side Badger`}
  description={t('support.description', locale)}
  breadcrumbName={t('support.title', locale)}
>
  <article class="content-page" data-page-type="support">
    <PageHero
      h1={t('support.title', locale)}
      lead={t('support.description', locale)}
      pageId="support"
      locale={locale}
    >
      <!-- Plain text, not a mailto link, to keep it from link-harvesting scrapers -->
      <p slot="action" class="support-email" dir="ltr">{t('support.email', locale)}</p>
    </PageHero>
  </article>
</BaseLayout>

<style>
  .support-email {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--text-primary);
    user-select: all;
  }
</style>
