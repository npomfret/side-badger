---
/**
 * The group-trips table: a villa shortlist with poll bars that fill, and a sticky note for the
 * cocktail round. The bars are decoration; `data-mech="bar"` marks them for the native engine.
 */
interface Props {
  one: string;
  two: string;
}
const { one, two } = Astro.props;
const votes = [72, 48, 26];
---

<div class="mech">
  <div class="poll" data-prop="paper">
    <p class="label">{one}</p>
    <div class="bars" aria-hidden="true">
      {
        votes.map((v, i) => (
          <span class="track">
            <span class="bar" data-mech="bar" style={`--v:${v}%;--i:${i}`} />
          </span>
        ))
      }
    </div>
  </div>
  <div class="note" data-prop="sticky">{two}</div>
</div>

<style>
  .mech {
    display: grid;
    gap: 1rem;
    min-inline-size: 0;
  }
  .poll {
    background: var(--paper);
    color: var(--ink);
    border-radius: 3px;
    box-shadow: var(--paper-shadow);
    padding: 0.875rem 1rem 1.125rem;
    display: grid;
    gap: 0.75rem;
    rotate: -1deg;
  }
  .label,
  .note {
    margin: 0;
    color: var(--ink);
    font-weight: 600;
    line-height: 1.3;
  }
  .bars {
    display: grid;
    gap: 0.5rem;
  }
  .track {
    display: block;
    block-size: 0.875rem;
    border-radius: 999px;
    background: #efe3c2;
    overflow: hidden;
  }
  .bar {
    display: block;
    block-size: 100%;
    inline-size: var(--v);
    border-radius: 999px;
    background: #1d5f78;
  }
  .note {
    background: var(--sticky-yellow);
    box-shadow: var(--paper-shadow);
    padding: 1rem 1rem 1.125rem;
    rotate: 1.5deg;
    max-inline-size: 22rem;
    justify-self: end;
    border-end-end-radius: 14px 4px;
    border-block-end: 4px solid var(--stripe, #f28c6b);
  }
</style>
