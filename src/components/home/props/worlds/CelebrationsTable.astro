---
/**
 * The celebrations table: a venue deposit slip and a comment that collects a party popper. Both
 * labels are content. `data-mech="comment"` marks the comment the native engine pops in.
 */
interface Props {
  one: string;
  two: string;
}
const { one, two } = Astro.props;
---

<div class="mech">
  <div class="slip" data-prop="paper">
    <p class="label">{one}</p>
  </div>
  <div class="comment" data-prop="bubble" data-mech="comment">
    <p class="label">{two}</p>
  </div>
</div>

<style>
  .mech {
    display: grid;
    gap: 1rem;
    min-inline-size: 0;
  }
  .slip {
    background: var(--paper);
    color: var(--ink);
    border-radius: 3px;
    border-block-start: 6px solid var(--gold, #c9a227);
    box-shadow: var(--paper-shadow);
    padding: 0.875rem 1rem 1.125rem;
    rotate: -1deg;
  }
  .label {
    margin: 0;
    color: var(--ink);
    font-weight: 600;
    line-height: 1.3;
  }
  .comment {
    background: var(--blush, #f4c7cf);
    color: var(--ink);
    border-radius: 1rem;
    border-end-start-radius: 0.25rem;
    padding: 0.75rem 1rem;
    box-shadow: var(--paper-shadow);
    max-inline-size: 22rem;
    justify-self: end;
    rotate: 1deg;
  }
</style>
