---
/**
 * The app's add-expense form (`ExpenseFormModal` with receipt scanning) as an illustration inside a
 * phone frame. Filled by default; `scan` adds scanning/review messages and field markers.
 * The caller maps its stages to inherited --scan-fields-opacity/offset, --scan-review-opacity/
 * visibility, --scan-scanning-opacity/visibility, --scan-transition-ms and --scan-stagger-ms hooks. Defaults rest
 * on the filled review state; this prop has no knowledge of scene stages or playback engines.
 * Who paid and how to split were already chosen. All motion is transforms and opacity.
 */
import { t, type Locale } from '@/i18n';
import AppFrame from '../../AppFrame.astro';
import { formatMoney } from '../../format';
import { expenseById, expenseTitle, memberName, receiptDate, SPLIT_KEYS } from './helpers';

interface Props {
  locale: Locale;
  scan?: boolean;
  sample?: { description: string; amount: string };
}
const { locale, scan = false, sample } = Astro.props;

const dinner = expenseById(4);
const fields = [
  { label: t('home.expenses.fieldDescription', locale), value: sample?.description ?? expenseTitle(dinner, locale), money: false },
  {
    label: t('home.expenses.fieldAmount', locale),
    value: sample?.amount ?? formatMoney(dinner.original.minor, dinner.original.currency, locale),
    money: true,
  },
  { label: t('home.expenses.fieldDate', locale), value: receiptDate(locale), money: false },
];
const splits = ['equal', 'exact', 'percent'] as const;
---

<AppFrame variant="phone" class="aef">
  {scan && <div class="aef__messages">
    <p class="aef__status aef__scanning"><span class="aef__dot" aria-hidden="true"></span>{t('home.expenses.scanning', locale)}</p>
    <p class="aef__status aef__review">{t('home.hero.scanReview', locale)}</p>
  </div>}
  {
    fields.map((field, i) => (
      <div class:list={['app-field', 'aef__field', { 'aef__field--review': scan }]}>
        <span>{field.label}</span>
        <span class="aef__row">
          <span
            class:list={['aef__val', { 'aef__landing': scan }]}
            data-testid={scan ? 'scan-field' : undefined}
            style={scan ? `--i:${i}` : undefined}
          >
            {field.money ? <bdi>{field.value}</bdi> : field.value}
          </span>
          {scan && <svg class="aef__tick" data-testid="scan-check" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M3 11l5 5L17 5" /></svg>}
        </span>
      </div>
    ))
  }
  <div class="app-field aef__field">
    <span>{t('home.expenses.fieldPaidBy', locale)}</span>
    <span class="aef__val">{memberName(dinner.paidBy, locale)}</span>
  </div>
  <div class="aef__split">
    <span class="aef__split-label">{t('home.expenses.fieldSplit', locale)}</span>
    <span class="aef__chips">
      {
        splits.map((kind) => (
          <span class:list={['aef__chip', { 'is-on': kind === dinner.split.kind }]}>
            {t(SPLIT_KEYS[kind], locale)}
          </span>
        ))
      }
    </span>
  </div>
</AppFrame>

<style>
  .aef__messages { display: grid; }
  .aef__messages > p { grid-area: 1 / 1; }
  .aef__scanning {
    opacity: var(--scan-scanning-opacity, 0);
    visibility: var(--scan-scanning-visibility, hidden);
  }
  .aef__review {
    opacity: var(--scan-review-opacity, 1);
    visibility: var(--scan-review-visibility, visible);
  }
  .aef__field--review { border-style: dashed; }
  .aef__landing {
    opacity: var(--scan-fields-opacity, 1);
    transform: translateX(calc(var(--scan-fields-offset, 0rem) * var(--dir)));
    transition: opacity var(--scan-transition-ms, 0s) linear, transform var(--scan-transition-ms, 0s) var(--ease-paper);
    transition-delay: calc(var(--i, 0) * var(--scan-stagger-ms, 0s));
  }
  .aef__tick { opacity: var(--scan-review-opacity, 1); }
  :is(.aef__tick, .aef__review, .aef__scanning) {
    /* Visibility hides at the end of the fade and becomes visible at its start. */
    transition: opacity var(--scan-transition-ms, 0s) linear, visibility var(--scan-transition-ms, 0s) linear;
  }
  .aef :global(.frame__screen) {
    gap: 0.375rem;
  }
  .aef:global(.frame--phone) {
    aspect-ratio: auto;
    inline-size: 100%;
    max-inline-size: 17.5rem;
  }
  @media (max-width: 599px) {
    .aef :global(.frame__screen) {
      gap: 0.25rem;
      padding: 0.5rem 0.625rem;
      padding-block-start: 1.375rem;
    }
    .aef :global(.app-field) {
      padding: 0.25rem 0.5rem;
    }
    .aef:global(.frame--phone) {
      padding: 0.5rem;
    }
  }
  .aef__status {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin: 0;
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    background: var(--app-tint);
    color: var(--app-primary-dark);
    font-weight: 600;
    font-size: 0.75rem;
  }
  .aef__dot {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    flex: none;
    border-radius: 50%;
    background: var(--app-primary);
  }
  .aef__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-block-size: 1.25rem;
  }
  .aef__val {
    font-weight: 600;
    min-inline-size: 0;
  }
  .aef__tick {
    inline-size: 1.125rem;
    block-size: 1.125rem;
    flex: none;
    fill: none;
    stroke: var(--app-primary-dark);
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .aef__split {
    display: grid;
    gap: 0.25rem;
  }
  .aef__split-label {
    font-size: 0.6875rem;
    color: #4b5563;
  }
  .aef__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  .aef__chip {
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    border: 1px solid #d1d5db;
    font-size: 0.6875rem;
    color: #374151;
  }
  .aef__chip.is-on {
    background: var(--app-primary-dark);
    border-color: var(--app-primary-dark);
    color: #fff;
  }
</style>
