---
import { getEntry, render } from 'astro:content';
import 'github-markdown-css/github-markdown-light.css';
import { localeConfig, t, tf, type Locale } from '../i18n';

interface Props {
  title: string;
  /** Snapshot id in the `policies` collection, e.g. `privacy-policy`. */
  policyId: 'privacy-policy' | 'terms-of-service' | 'cookie-policy';
  locale: Locale;
}

const { title, policyId, locale } = Astro.props;

const entry = await getEntry('policies', policyId);
if (!entry) {
  throw new Error(`Policy snapshot "${policyId}" is missing. Run "npm run policies:sync".`);
}
const { Content } = await render(entry);

const isEnglish = locale === 'en';
let updated: string;
try {
  updated = new Intl.DateTimeFormat(localeConfig[locale].intlCode, { dateStyle: 'long', timeZone: 'UTC' }).format(
    entry.data.publishedAt
  );
} catch {
  updated = new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' }).format(entry.data.publishedAt);
}
---

<section class="legal-page" aria-labelledby="policy-title">
  <div class="container">
    <div class="legal-content glass fade-up">
      <h1 id="policy-title" class="policy-title">{title}</h1>
      <p class="policy-updated">
        <time datetime={entry.data.publishedAt.toISOString()}>{tf('policy.lastUpdated', { date: updated }, locale)}</time>
      </p>
      {!isEnglish && <p class="policy-notice" role="note">{t('policy.englishOnly', locale)}</p>}
      <div class="policy-content markdown-body" lang="en" dir="ltr">
        <Content />
      </div>
    </div>
  </div>
</section>

<style>
  @import '../styles/policy.css';
</style>
